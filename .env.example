# Stripe Configuration (REQUIRED)
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET=sk_test_your_secret_key_here
STRIPE_PUBLIC_KEY=pk_test_your_publishable_key_here

# Stripe Webhook Secret (REQUIRED)
# Get this by running: stripe listen --forward-to localhost:4000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_from_stripe_cli

# Radar Configuration (Optional - defaults to test key if not set)
# Get this from: https://radar.com/dashboard
# RADAR_PUBLIC_KEY=prj_live_pk_...

# Email Configuration (Optional - has sensible defaults)
# EMAIL_FROM=info@ysc.org
# EMAIL_FROM_NAME=YSC
# EMAIL_CONTACT=info@ysc.org
# EMAIL_ADMIN=admin@ysc.org
# EMAIL_MEMBERSHIP=memberships@ysc.org
# EMAIL_BOARD=board@ysc.org
# EMAIL_VOLUNTEER=volunteer@ysc.org
# EMAIL_TAHOE=tahoe@ysc.org
# EMAIL_CLEAR_LAKE=cl@ysc.org

# Google Photos (admin OAuth — separate from member login GOOGLE_CLIENT_ID)
# Create a Web application OAuth client in Google Cloud with Photos Library API enabled.
# Redirect URI: http://localhost:4000/admin/integrations/google-photos/callback
# GOOGLE_PHOTOS_CLIENT_ID=your_client_id
# GOOGLE_PHOTOS_CLIENT_SECRET=your_client_secret
# Optional: override redirect URI (defaults to PHX_HOST + callback path)
# GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:4000/admin/integrations/google-photos/callback
# Optional: seed refresh token without UI (dev only)
# GOOGLE_PHOTOS_REFRESH_TOKEN=your_refresh_token

# ChromicPDF / TV poster generation (Optional)
# ChromicPDF spawns headless Chrome on startup to generate event TV-poster images.
# If you don't need that locally, set this to skip the Chrome session pool entirely.
# CHROMIC_PDF_ENABLED=false

# QuickBooks Configuration (Optional - only needed for QuickBooks integration testing)
# Get these from: https://developer.intuit.com/
# QUICKBOOKS_CLIENT_ID=your_client_id
# QUICKBOOKS_CLIENT_SECRET=your_client_secret
# QUICKBOOKS_COMPANY_ID=your_company_id
# QUICKBOOKS_ACCESS_TOKEN=your_access_token
# QUICKBOOKS_REFRESH_TOKEN=your_refresh_token
# QUICKBOOKS_REALM_ID=your_realm_id
# QUICKBOOKS_APP_ID=your_app_id
# QUICKBOOKS_BASE_URL=https://sandbox-quickbooks.api.intuit.com/v3
# QUICKBOOKS_BANK_ACCOUNT_ID=35
# QUICKBOOKS_STRIPE_ACCOUNT_ID=1150040000
# Optional: QuickBooks Customer ID for payments with no user (avoids :user_not_found when exporting payouts)
# QUICKBOOKS_SYSTEM_CUSTOMER_ID=
