{
    "default_stop_words": [
        "defmodule",
        "defrecord",
        "defimpl",
        "defexception",
        "defprotocol",
        "defstruct",
        "def.+(.+\\\\.+).+do",
        "^\\s+use\\s+"
    ],

    "custom_stop_words": [],

    "print_summary": true,

    "coverage_options": {
        "treat_no_relevant_lines_as_covered": false,
        "output_dir": "cover/",
        "minimum_coverage": 0,
        "floor_coverage": true
    },

    "terminal_options": {
        "file_column_width": 40
    },

    "skip_files": [
        "ysc/application\\.ex",
        "ysc/cldr\\.ex",
        "deps/ex_cldr",
        "ysc_web/live/tahoe_cabin_rules_live\\.ex",
        "ysc_web/live/tahoe_staying_with_live\\.ex",
        "ysc_web/live/property_check_in_live\\.ex",
        "ysc_web/test_log_filter\\.ex",
        "mix/tasks/",
        "test/support/",
        "lib/ysc_web/authorization/policy.ex",
        "lib/ysc.ex",
        "ysc/customers/behaviour\\.ex",
        "ysc/payments/behaviour\\.ex",
        "ysc/quickbooks/client\\.ex",
        "ysc/quickbooks/client_behaviour\\.ex",
        "ysc/stripe_behaviour\\.ex",
        "ysc/stripe/.*_behaviour\\.ex",
        "ysc/release.ex",
        "dev/ysc/credo/\\.ex",
        "mix/tasks/\\.ex",
        "lib/ysc/wp_migration/\\.ex"
    ]
}