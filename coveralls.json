  "print_summary": true,

  "coverage_options": {
    "treat_no_relevant_lines_as_covered": true,
    "output_dir": "cover/",
    "minimum_coverage": 80,
    "floor_coverage": true
  },

  "terminal_options": {
    "file_column_width": 40
  },

