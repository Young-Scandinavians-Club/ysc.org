<div id="app-container" class="w-full flex flex-col min-h-screen">
  <% {toasts_sync, flash} = YscWeb.Layouts.toasts_sync_with_flash(assigns) %>
  <.toast_group
    flash={flash}
    connected={assigns[:socket] != nil}
    corner={:top_right}
    toasts_sync={toasts_sync}
    group_class_fn={&YscWeb.Layouts.toast_group_class_fn/1}
  />
  <%!-- Screen-reader mirror of flash; keeps flash text in the DOM so tests and assistive technology can detect it --%>
  <div id="flash-mirror" aria-live="polite" class="sr-only">
    <span :if={@flash["info"]}>{@flash["info"]}</span>
    <span :if={@flash["error"]}>{@flash["error"]}</span>
  </div>

  <main class="flex-1 w-full">
    {@inner_content}
  </main>
</div>
