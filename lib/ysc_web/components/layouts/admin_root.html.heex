<!DOCTYPE html>
<html
  lang="en"
  class={[
    "[scrollbar-gutter:stable]",
    assigns[:sidebar_collapsed] && "sidebar-collapsed"
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%!-- Apply sidebar collapsed state before first paint to avoid layout flash --%>
    <script nonce={@csp_nonce}>
      try {
        if (localStorage.getItem("admin-sidebar-collapsed") === "true") {
          document.documentElement.classList.add("sidebar-collapsed");
        }
      } catch (_) {}
    </script>
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      :if={assigns[:meta_description]}
      name="description"
      content={assigns[:meta_description]}
    />
    <.live_title suffix=" · YSC.org Admin">
      {assigns[:page_title] || "YSC Admin"}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/app.css"}
      nonce={@csp_nonce}
    />
    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/admin.css"}
      nonce={@csp_nonce}
    />
    <%!-- API keys as meta tags — always present, read by JS hooks on demand --%>
    <meta
      name="radar-public-key"
      content={Application.get_env(:ysc, :radar)[:public_key]}
    />
    <%!-- Sentry monitoring — defer keeps it off the critical path; app.js waits for it via waitForSentry() --%>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/sentry.min.js"}
      nonce={@csp_nonce}
    >
    </script>
    <%!-- Admin hooks bundle - must be deferred before app.js so window.__adminHooks is set first --%>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/admin.js"}
      nonce={@csp_nonce}
    >
    </script>
    <%!-- Main application bundle - deferred but will run after Sentry since it comes after --%>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
      nonce={@csp_nonce}
    >
    </script>
    <script nonce={@csp_nonce}>
      <%= if assigns[:current_user] do %>
      window.currentUser = {
        id: "<%= @current_user.id %>",
        email: "<%= @current_user.email %>",
        role: "<%= @current_user.role %>",
        state: "<%= @current_user.state %>"
      };
      <% else %>
      window.currentUser = null;
      <% end %>
    </script>
  </head>
  <body class="antialiased bg-white">
    <.impersonation_banner
      :if={assigns[:impersonating?] && @current_user}
      impersonating?={assigns[:impersonating?]}
      impersonated_user_name={"#{@current_user.first_name} #{@current_user.last_name}"}
      impersonated_user_email={@current_user.email}
    />
    <div class={[
      "flex flex-col min-h-screen",
      assigns[:impersonating?] && "pb-[72px]"
    ]}>
      {@inner_content}
    </div>
  </body>
</html>
