                      </g>
                    </mask>
                  </defs>
                  <rect
                    x="8"
                    y="7"
                    width="48"
                    height="50"
                    rx="8"
                    ry="8"
                    fill="currentColor"
                    mask="url(#partiful-footer-icon-mask)"
                  />
                </svg>
                <span class="sr-only">Partiful</span>
              </.link>
            </li>

            <li
              :if={@current_user && @site_setting_socials_whatsapp}
              class="w-10 h-10 flex text-center items-center justify-center"
            >
              <.link
                href={@site_setting_socials_whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="20 20 472 472"
                  class="w-8 h-8 transition duration-300 fill-current text-zinc-600 hover:text-[#25d366]"
                >
                  <path d="M256,122.2c-73,0-132.4,59.4-132.5,132.4c0,25,7,49.4,20.3,70.4l3.1,5l-13.4,48.8l50.1-13.2l4.8,2.9   c20.3,12.1,43.6,18.5,67.4,18.5h0.1c72.9,0,133.9-59.4,133.9-132.4c0-35.4-15.3-68.6-40.3-93.6C324.5,136,291.4,122.2,256,122.2   L256,122.2z M333.8,311.4c-3.3,9.3-19.2,17.8-26.8,18.9c-12.7,1.9-22.5,0.9-47.7-9.9c-39.9-17.3-66-57.5-68-60.1   c-2-2.6-16.3-21.6-16.3-41.2s10.2-29.2,14-33.2c3.6-4,7.9-5,10.6-5c2.6,0,5.3,0,7.6,0.1c2.4,0.1,5.7-0.9,8.9,6.8   c3.3,7.9,11.2,27.5,12.3,29.5c1,2,1.7,4.3,0.3,6.9c-7.6,15.3-15.8,14.7-11.7,21.7c15.4,26.4,30.7,35.6,54.1,47.3c4,2,6.3,1.7,8.6-1   c2.3-2.6,9.9-11.7,12.6-15.6c2.6-4,5.3-3.3,8.9-2s23.2,10.9,27.2,13c4,2,6.6,3,7.6,4.6C337.2,294.2,337.2,302.2,333.8,311.4z    M432.8,31H79.2C52.6,31,31,52.6,31,79.2v353.6c0,26.6,21.6,48.2,48.2,48.2h353.6c26.6,0,48.2-21.6,48.2-48.2V79.2   C481,52.6,459.4,31,432.8,31z M255.9,413.9c-26.7,0-52.9-6.7-76.1-19.4l-84.5,22.2l22.6-82.6c-14-24.1-21.3-51.5-21.3-79.7   c0.1-87.8,71.5-159.2,159.3-159.2c42.6,0,82.6,16.6,112.7,46.7c30,30.1,48.1,70.1,48.1,112.7C416.7,342.5,343.7,413.9,255.9,413.9   L255.9,413.9z" />
                </svg>
                <span class="sr-only">WhatsApp</span>
              </.link>
            </li>
          </ul>
        </div>

        <p class="text-xs text-zinc-500 text-center sm:text-left max-w-prose">
          YSC is a 501(c)(7) not-for-profit incorporated in the State of California.
        </p>
      </div>
    </div>
  </footer>

  <.toast_group_with_bridge
    connected={assigns[:socket] != nil}
    corner={:top_right}
    {assigns}
  />
  <%!-- Screen-reader mirror of flash; keeps flash text in the DOM so tests and assistive technology can detect it --%>
  <div id="flash-mirror" aria-live="polite" class="sr-only">
    <span :if={@flash["info"]}>{@flash["info"]}</span>
    <span :if={@flash["error"]}>{@flash["error"]}</span>
  </div>
</div>
