<!DOCTYPE html>
<html
  lang="en"
  class="[scrollbar-gutter:stable]"
  data-app-env={Application.get_env(:ysc, :environment, "production")}
  data-s3-use-custom-domain={
    if Ysc.S3Config.use_custom_s3_domain?(), do: "true", else: "false"
  }
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      :if={assigns[:meta_description]}
      name="description"
      content={assigns[:meta_description]}
    />
    <%!-- Open Graph / Twitter Card — used as link previews on external sites --%>
    <meta property="og:site_name" content="Young Scandinavians Club" />
    <meta property="og:locale" content="en_US" />
    <meta
      property="og:type"
      content={assigns[:og_type] || "website"}
    />
    <meta
      property="og:title"
      content={assigns[:page_title] || "YSC"}
    />
    <meta
      :if={assigns[:meta_description]}
      property="og:description"
      content={assigns[:meta_description]}
    />
    <meta
      :if={assigns[:og_url]}
      property="og:url"
      content={assigns[:og_url]}
    />
    <meta
      property="og:image"
      content={YscWeb.SEO.og_image_or_default(assigns[:og_image])}
    />
    <meta
      name="twitter:card"
      content={YscWeb.SEO.twitter_card_for_image(assigns[:og_image])}
    />
    <meta
      name="twitter:title"
      content={assigns[:page_title] || "YSC"}
    />
    <meta
      :if={assigns[:meta_description]}
      name="twitter:description"
      content={assigns[:meta_description]}
    />
    <meta
      name="twitter:image"
      content={YscWeb.SEO.og_image_or_default(assigns[:og_image])}
    />
    <link
      :if={assigns[:canonical_url]}
      rel="canonical"
      href={assigns[:canonical_url]}
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="icon"
      phx-track-static
      href={~p"/favicon.ico"}
      type="image/x-icon"
      sizes="any"
    />
    <link
      rel="icon"
      phx-track-static
      type="image/png"
      sizes="32x32"
      href={~p"/favicon-32x32.png"}
    />
    <link
      rel="icon"
      phx-track-static
      type="image/png"
      sizes="16x16"
      href={~p"/favicon-16x16.png"}
    />
    <link
      rel="apple-touch-icon"
      phx-track-static
      href={~p"/apple-touch-icon.png"}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="YSC Events"
      href={url(~p"/feeds/events.atom")}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="YSC Club News"
      href={url(~p"/feeds/posts.atom")}
    />
    <.live_title suffix=" · Young Scandinavians Club">
      {assigns[:page_title] || "YSC"}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/app.css"}
      nonce={@csp_nonce}
    />
    <%!-- API keys as meta tags — always present, read by JS hooks on demand --%>
    <meta
      name="stripe-publishable-key"
      content={Application.get_env(:stripity_stripe, :public_key)}
    />
    <meta
      name="radar-public-key"
      content={Application.get_env(:ysc, :radar)[:public_key]}
    />
    <%!-- Sentry monitoring — defer keeps it off the critical path; app.js waits for it via waitForSentry() --%>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/sentry.min.js"}
      nonce={@csp_nonce}
    >
    </script>
    <%!-- Main application bundle — deferred; runs after sentry.min.js due to DOM order --%>
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
      nonce={@csp_nonce}
    >
    </script>
    <script nonce={@csp_nonce}>
      <%= if assigns[:current_user] do %>
      window.currentUser = {
        id: "<%= @current_user.id %>",
        email: "<%= @current_user.email %>",
        role: "<%= @current_user.role %>",
        state: "<%= @current_user.state %>"
      };
      <% else %>
      window.currentUser = null;
      <% end %>
    </script>
    <Turnstile.script nonce={@csp_nonce} />
  </head>
  <body class="antialiased bg-white">
    <.impersonation_banner
      :if={assigns[:impersonating?] && @current_user}
      impersonating?={assigns[:impersonating?]}
      impersonated_user_name={"#{@current_user.first_name} #{@current_user.last_name}"}
      impersonated_user_email={@current_user.email}
    />
    <div
      id="content-wrapper"
      class={[
        "flex flex-col min-h-screen",
        assigns[:impersonating?] && "pb-[72px]"
      ]}
    >
      <div
        :if={
          @current_user && @current_user.role in [:admin, :volunteer] &&
            !assigns[:impersonating?]
        }
        id="admin-floating-button-wrap"
        phx-hook="AdminFloatingButton"
        phx-update="ignore"
        class="fixed z-[110] admin-floating-bottom-left group print:hidden"
      >
        <.link
          navigate={~p"/admin"}
          class="flex items-center gap-0 group-hover:gap-3 group-[.corner-right]:flex-row-reverse bg-zinc-800/80 backdrop-blur-sm px-2 py-2 group-hover:px-3 rounded-full shadow-lg border border-white/10 hover:bg-zinc-700/90 transition-all duration-300 hover:scale-105 active:scale-95 overflow-hidden opacity-90 hover:opacity-100"
        >
          <div class="bg-blue-500 rounded-full p-1.5 shadow flex-shrink-0">
            <.icon
              name="hero-cog"
              class="w-6 h-6 text-white group-hover:animate-[spin_10s_linear_infinite] transition-transform duration-300"
            />
          </div>
          <span class="font-bold tracking-tight max-w-0 group-hover:max-w-[200px] group-hover:pr-1 group-[.corner-right]:group-hover:pl-1 group-[.corner-right]:group-hover:pr-0 overflow-hidden opacity-0 group-hover:opacity-100 transition-all duration-300 whitespace-nowrap text-white text-sm">
            Admin Dashboard
          </span>
        </.link>
      </div>
      {@inner_content}
    </div>
  </body>
</html>
