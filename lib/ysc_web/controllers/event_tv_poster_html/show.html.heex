<div class="min-h-screen flex flex-col items-center justify-center gap-6 p-8">
  <p class="text-sm text-zinc-400 font-medium tracking-wide uppercase print:hidden">
    TV poster preview · 1920×1080 · scroll or zoom to inspect
  </p>
  <.event_tv_poster
    event={@event}
    sold_out={@sold_out}
    selling_fast={@selling_fast}
  />
</div>
