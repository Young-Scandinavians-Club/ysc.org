<div class="py-6 lg:py-8 max-w-(--breakpoint-xl) mx-auto px-4">
  <.page_masthead
    id="financials-masthead"
    size={:compact}
    eyebrow="Governance"
    title="Financials & Annual Meetings"
  />

  <%!-- Quick Stats Section (Current Year) --%>
  <div
    id="financials-at-a-glance"
    class="mb-8 bg-linear-to-br from-blue-50 to-zinc-50 border border-blue-200 rounded-xl p-6 shadow-xs"
  >
    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 mb-4">
      <.icon_heading id="financials-at-a-glance-heading" class="text-zinc-900">
        <:leading>
          <.icon name="hero-chart-bar" class="w-6 h-6 text-blue-600" />
        </:leading>
        2025 at a glance
      </.icon_heading>
      <span class="type-eyebrow text-xs text-blue-700 bg-blue-100 px-2.5 py-1 rounded-full">
        Reported at the 2026 meeting
      </span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl p-4 border border-zinc-200">
        <div class="flex items-center justify-between gap-2 text-sm text-zinc-500 mb-1 type-eyebrow">
          Active Members
          <.icon name="hero-users" class="w-4 h-4 text-zinc-400" />
        </div>
        <div class="text-2xl text-zinc-900 type-title">550</div>
        <div class="text-xs text-zinc-500 mt-1">188 single, 181 families</div>
      </div>
      <div class="bg-white rounded-xl p-4 border border-zinc-200">
        <div class="flex items-center justify-between gap-2 text-sm text-zinc-500 mb-1 type-eyebrow">
          Income after expenses
          <.icon name="hero-banknotes" class="w-4 h-4 text-zinc-400" />
        </div>
        <div class="text-2xl text-zinc-900 type-title">$126,999.52</div>
        <div class="text-xs text-zinc-500 mt-1">Incl. $100K donation</div>
      </div>
      <div class="bg-white rounded-xl p-4 border border-zinc-200">
        <div class="flex items-center justify-between gap-2 text-sm text-zinc-500 mb-1 type-eyebrow">
          Memberships
          <.icon name="hero-arrow-trending-up" class="w-4 h-4 text-zinc-400" />
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl text-zinc-900 type-title">369</span>
          <span class="text-xs font-semibold text-green-700 bg-green-100 px-1.5 py-0.5 rounded-sm">
            +11.8%
          </span>
        </div>
        <div class="text-xs text-zinc-500 mt-1">Up from 330 (146 new)</div>
      </div>
    </div>
  </div>

  <%!-- Jump to Year Navigation --%>
  <nav
    id="financials-year-nav"
    aria-label="Jump to meeting year"
    class="mb-8 bg-white/90 backdrop-blur-md border border-zinc-200 rounded-lg px-3 py-2 sticky top-4 z-10 shadow-xs"
  >
    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
      <span class="type-eyebrow text-xs text-zinc-500 px-2 shrink-0">
        Jump to
      </span>
      <.link
        :for={meeting <- recent_meetings()}
        href={"#year-#{meeting.year}"}
        class="shrink-0 px-3 py-1.5 rounded-full text-sm font-medium text-zinc-700 bg-zinc-100 hover:bg-blue-50 hover:text-blue-700 transition-colors"
      >
        {meeting.year}
      </.link>
      <span class="h-5 w-px bg-zinc-200 mx-1 shrink-0" aria-hidden="true"></span>
      <.link
        :for={meeting <- archived_meetings()}
        href={"#year-#{meeting.year}"}
        data-opens-details="financials-archive"
        class="shrink-0 px-3 py-1.5 rounded-full text-sm font-medium text-zinc-500 hover:bg-blue-50 hover:text-blue-700 transition-colors"
      >
        {meeting.year}
      </.link>
    </div>
  </nav>

  <%!-- Financial Reports by Year --%>
  <div class="space-y-6">
    <.annual_meeting_section
      :for={{meeting, index} <- Enum.with_index(recent_meetings())}
      id={"year-#{meeting.year}"}
      title={"#{meeting.year} General Meeting"}
      badge={if index == 0, do: "Latest"}
      note={"Reviews FY #{meeting.fy}"}
    >
      <.document_download_card
        :for={{kind, href, meta} <- meeting.docs}
        id={"financials-#{meeting.year}-#{kind}"}
        href={href}
        title={doc_title(kind, meeting.fy)}
        meta={meta}
        kind={kind}
      />
    </.annual_meeting_section>

    <%!-- Older Years (Collapsible) --%>
    <details
      id="financials-archive"
      class="group/archive bg-white border border-zinc-200 rounded-xl shadow-xs overflow-hidden"
    >
      <summary class="flex items-center justify-between gap-3 bg-zinc-50 px-6 py-4 cursor-pointer hover:bg-zinc-100 transition-colors list-none group-open/archive:border-b group-open/archive:border-zinc-200">
        <div class="flex items-center gap-3">
          <.icon name="hero-archive-box" class="w-5 h-5 text-zinc-500" />
          <h2 class="text-zinc-900 text-xl m-0 type-subhead">
            Archive (2022 – 2018)
          </h2>
          <span class="type-eyebrow text-xs text-zinc-600 bg-zinc-200 px-2 py-0.5 rounded-full">
            {length(archived_meetings())} years
          </span>
        </div>
        <.icon
          name="hero-chevron-down"
          class="w-5 h-5 text-zinc-500 shrink-0 transition-transform group-open/archive:rotate-180"
        />
      </summary>
      <div class="divide-y divide-zinc-200">
        <.annual_meeting_section
          :for={meeting <- archived_meetings()}
          id={"year-#{meeting.year}"}
          title={"#{meeting.year} General Meeting"}
          note={"Reviews FY #{meeting.fy}"}
          variant={:archive}
        >
          <.document_download_card
            :for={{kind, href, meta} <- meeting.docs}
            id={"financials-#{meeting.year}-#{kind}"}
            href={href}
            title={doc_title(kind, meeting.fy)}
            meta={meta}
            kind={kind}
          />
        </.annual_meeting_section>
      </div>
    </details>
  </div>
</div>
