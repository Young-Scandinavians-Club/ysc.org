<div class="py-8 lg:py-12 max-w-screen-xl mx-auto px-4">
  <%!-- Page Header --%>
  <div class="mb-10">
    <h1 class="text-4xl font-extrabold tracking-tight text-zinc-900 mb-4">
      Financials & Annual Meetings
    </h1>
    <p class="text-lg text-zinc-600 max-w-2xl">
      Access official reports, meeting minutes, and financial disclosures for Young Scandinavians Club.
    </p>
  </div>

  <%!-- Quick Stats Section (Current Year) --%>
  <div class="mb-10 bg-gradient-to-br from-blue-50 to-zinc-50 border border-blue-200 rounded-xl p-6 shadow-sm">
    <h2 class="text-xl font-bold text-zinc-900 mb-4 flex items-center gap-2">
      <.icon name="hero-chart-bar" class="w-6 h-6 text-blue-600" />
      FY 2025 At a Glance
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl p-4 border border-zinc-200">
        <div class="text-sm text-zinc-500 uppercase tracking-wider mb-1">
          Active Members
        </div>
        <div class="text-2xl font-bold text-zinc-900">550</div>
        <div class="text-xs text-zinc-500 mt-1">188 single, 181 families</div>
      </div>
      <div class="bg-white rounded-xl p-4 border border-zinc-200">
        <div class="text-sm text-zinc-500 uppercase tracking-wider mb-1">
          Net Revenue
        </div>
        <div class="text-2xl font-bold text-zinc-900">$126,999.52</div>
        <div class="text-xs text-zinc-500 mt-1">Incl. $100K donation</div>
      </div>
      <div class="bg-white rounded-xl p-4 border border-zinc-200">
        <div class="text-sm text-zinc-500 uppercase tracking-wider mb-1">
          Memberships
        </div>
        <div class="text-2xl font-bold text-zinc-900">369</div>
        <div class="text-xs text-zinc-500 mt-1">Up from 330 (146 new)</div>
      </div>
    </div>
  </div>

