<div class="py-6 md:py-12">
  <.history_masthead years={@years_since_founding} />
  <.back_to_top />

  <div class="max-w-(--breakpoint-xl) mx-auto px-4">
    <div class="prose prose-zinc prose-a:text-blue-600 mt-16 md:mt-24 mb-8">
      <h2 id="key-events" class="mb-2">Key Events</h2>
      <p class="mt-0 text-sm text-zinc-500 flex items-center gap-1.5">
        <.icon name="hero-clock" class="w-4 h-4" /> About a 12 minute read
      </p>
    </div>

    <.timeline_filters decades={Enum.map(@timeline_decades, & &1.label)} />

    <.timeline>
      <.timeline_decade
        :for={decade <- @timeline_decades}
        id={decade.id}
        label={decade.label}
      >
        <.timeline_event_from_data :for={event <- decade.events} event={event} />
      </.timeline_decade>
    </.timeline>

    <.presidents_section presidents={@past_presidents} />
    <.history_cta years={@years_since_founding} />
  </div>
</div>
