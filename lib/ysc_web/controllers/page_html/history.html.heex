<div class="py-6 md:py-12">
  <.history_masthead years={@years_since_founding} />
  <.back_to_top />

  <div class="max-w-screen-xl mx-auto px-4">
    <div class="prose prose-zinc prose-a:text-blue-600 mb-8 scroll-mt-24">
      <h2 id="key-events">Key Events</h2>
    </div>

    <.timeline_filters />

    <.timeline>
      <%= for event <- @timeline_events do %>
        <%= case event.type do %>
          <% :decade -> %>
            <.timeline_decade label={event.year} />
          <% _ -> %>
            <.timeline_event_from_data event={event} />
        <% end %>
      <% end %>
    </.timeline>

    <.presidents_section presidents={@past_presidents} />
    <.history_cta years={@years_since_founding} />
  </div>
</div>
