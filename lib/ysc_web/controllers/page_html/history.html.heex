<div class="pb-10 max-w-screen-xl mx-auto px-4">
  <%!-- Anniversary Hero Section --%>
  <div
    id="history-hero"
    class="mb-20 text-center relative overflow-hidden py-12 -mx-4"
  >
    <%!-- Enhanced background with desaturated overlay effect - full width --%>
    <div class="absolute left-0 right-0 top-0 bottom-0 bg-gradient-to-b from-zinc-100 via-blue-50/40 to-transparent opacity-60">
    </div>
    <%!-- Refined geometric pattern - full width --%>
    <div
      class="absolute left-0 right-0 top-0 bottom-0 opacity-20"
      style="background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%239C92AC%22 fill-opacity=%220.04%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"
    >
    </div>

    <div class="relative px-4">
      <div class="relative inline-block mb-6">
        <div class="absolute -inset-6 bg-blue-600/5 rounded-full blur-3xl">
        </div>
        <h1 class="relative text-7xl md:text-9xl font-black text-zinc-900 tracking-tighter mb-4">
          {div(Date.utc_today().year - 1950, 5) * 5}+
          <span class="text-3xl md:text-5xl align-top mt-4 inline-block text-blue-600">
            Years
          </span>
        </h1>
      </div>
      <%!-- Elegant serif typography for established line --%>
      <p
        class="text-zinc-600 tracking-[0.25em] text-sm mb-2"
        style="font-family: Georgia, 'Times New Roman', serif; font-style: italic; letter-spacing: 0.15em;"
      >
        Established 1950
      </p>
      <p class="text-zinc-400 uppercase tracking-[0.3em] font-bold text-xs mb-8">
        San Francisco, California
      </p>

      <div class="max-w-2xl mx-auto border-t border-zinc-200 pt-10 px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-zinc-900 mb-6">
          A Legacy of Friendship: The YSC Story
        </h2>
        <p class="text-xl text-zinc-600 leading-relaxed font-light mb-6">
          What started as five friends in a post-war city has blossomed into a multi-generational community. Today, we steward two historic properties and a legacy of Scandinavian culture in California.
        </p>
        <blockquote class="border-l-4 border-blue-600 pl-6 italic text-zinc-700 my-8 text-left max-w-xl mx-auto">
          <p class="text-lg leading-relaxed">
            Established in 1950 by five friends—<strong>Arnold Rolkert</strong>, <strong>Gunnar Engen</strong>, <strong>Carlo Hojsgaard</strong>, <strong>Peter Larsen Bernard</strong>, and <strong>Ulla Lindberg</strong>—the YSC has blossomed into a thriving community for Scandinavian and Scandinavian-American individuals and families.
          </p>
        </blockquote>
      </div>
    </div>
  </div>

  <%!-- Back to Top Button --%>
  <button
    phx-hook="BackToTop"
    id="back-to-top"
    class="fixed bottom-8 right-8 z-20 opacity-0 pointer-events-none transition-opacity duration-300 bg-blue-600 text-white p-3 rounded-full shadow-lg hover:bg-blue-700"
    aria-label="Back to top"
  >
    <.icon name="hero-arrow-up" class="w-6 h-6" />
  </button>

  <%!-- Key Events Timeline --%>
  <div class="mb-16">
    <div class="prose prose-zinc prose-a:text-blue-600 mb-8 scroll-mt-24">
      <h2 id="key-events">Key Events</h2>
    </div>

    <%!-- Reading Time & Filters --%>
    <div class="not-prose mb-12">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-zinc-200">
        <div class="flex items-center gap-2 text-sm text-zinc-500">
          <.icon name="hero-clock" class="w-4 h-4" />
          <span>~12 min read</span>
        </div>
        <div class="text-xs text-zinc-400 hidden sm:block">
          <.icon name="hero-funnel" class="w-4 h-4 inline" /> Filter by category
        </div>
      </div>

      <%!-- Enhanced Filter Buttons --%>
      <div
        id="timeline-filters"
        phx-hook="TimelineFilter"
        class="flex flex-wrap gap-2 mt-4"
      >
        <button
          data-filter="all"
          class="px-4 py-2.5 rounded-full text-sm font-bold bg-blue-600 text-white shadow-sm hover:shadow-md transition-all hover:scale-105"
        >
          <.icon name="hero-squares-2x2" class="w-4 h-4 inline mr-1" />
          All Events
        </button>
        <button
          data-filter="founding"
          class="px-4 py-2.5 rounded-full text-sm font-semibold bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100 transition-all hover:scale-105"
        >
          <.icon name="hero-sparkles" class="w-4 h-4 inline mr-1" /> Founding
        </button>
        <button
          data-filter="club leadership"
          class="px-4 py-2.5 rounded-full text-sm font-semibold bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition-all hover:scale-105"
        >
          <.icon name="hero-user-group" class="w-4 h-4 inline mr-1" />
          Leadership
        </button>
        <button
          data-filter="real estate"
          class="px-4 py-2.5 rounded-full text-sm font-semibold bg-orange-50 text-orange-700 border border-orange-200 hover:bg-orange-100 transition-all hover:scale-105"
        >
          <.icon name="hero-home-modern" class="w-4 h-4 inline mr-1" />
          Real Estate
        </button>
        <button
          data-filter="cabin life"
          class="px-4 py-2.5 rounded-full text-sm font-semibold bg-green-50 text-green-700 border border-green-200 hover:bg-green-100 transition-all hover:scale-105"
        >
          <.icon name="hero-home" class="w-4 h-4 inline mr-1" /> Cabin Life
        </button>
        <button
          data-filter="anniversary"
          class="px-4 py-2.5 rounded-full text-sm font-semibold bg-yellow-50 text-yellow-700 border border-yellow-200 hover:bg-yellow-100 transition-all hover:scale-105"
        >
          <.icon name="hero-cake" class="w-4 h-4 inline mr-1" /> Anniversaries
        </button>
      </div>
    </div>

    <div class="not-prose">
      <%!-- Sticky Decade Navigator --%>
      <div
        id="decade-navigator"
        phx-hook="DecadeIndicator"
        class="sticky top-6 z-30 mb-6 bg-white/95 backdrop-blur-sm border border-zinc-200 rounded-full px-4 py-2 shadow-md"
      >
        <div class="flex items-center justify-center gap-3 text-xs font-semibold text-zinc-600">
          <.icon name="hero-clock" class="w-4 h-4 text-blue-600" />
          <span id="current-decade-indicator" class="min-w-[120px] text-center">
            Exploring {div(Date.utc_today().year - 1950, 5) * 5} Years
          </span>
          <div class="flex gap-1 ml-2 border-l border-zinc-300 pl-3">
            <a
              href="#key-events"
              class="px-2 py-1 rounded hover:bg-blue-100 transition-colors text-blue-600"
              title="Jump to top"
            >
              ↑ Top
            </a>
            <a
              href="#presidents"
              class="px-2 py-1 rounded hover:bg-blue-100 transition-colors text-blue-600"
              title="Jump to presidents"
            >
              ↓ Presidents
            </a>
          </div>
        </div>
      </div>

      <%!-- Timeline Container --%>
      <div class="relative">
        <%!-- Vertical Timeline Line - positioned with left margin matching year space --%>
        <div class="hidden md:block absolute left-32 lg:left-40 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-600 via-blue-400 to-zinc-200 z-0">
        </div>

        <%!-- Timeline Items --%>
        <div class="space-y-8">
          <%!-- 1950s Decade Watermark --%>
          <div class="relative">
            <div class="decade-watermark">1950s</div>
          </div>

          <%!-- 1950 - YSC Founded --%>
          <div
            data-timeline-item
            data-tags="founding, club leadership"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <%!-- Year label --%>
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1950
              </span>
            </div>
            <%!-- Timeline dot - centered on the line --%>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-4 h-4 md:w-5 md:h-5 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20 group-hover:scale-125 transition-transform">
            </div>
            <%!-- Content --%>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-gradient-to-br from-blue-600 to-blue-800 text-white rounded-xl p-6 md:p-8 shadow-lg group-hover:shadow-xl transition-all duration-300 overflow-hidden">
                <div class="flex flex-wrap gap-2 mb-4">
                  <.icon name="hero-sparkles" class="w-5 h-5 text-blue-200" />
                  <span class="px-3 py-1 bg-white/20 text-white text-xs font-bold uppercase rounded-full">
                    Founder's Corner
                  </span>
                  <span class="px-3 py-1 bg-white/20 text-white text-xs font-bold uppercase rounded-full">
                    Founding
                  </span>
                </div>
                <h3 class="text-2xl md:text-3xl font-bold mb-4">
                  The Beginning: Five Friends, One Vision
                </h3>

                <%!-- Historic Image with archival styling and stacked paper effect --%>
                <div class="mb-4 archival-photo era-1950s stacked-paper rounded-lg overflow-hidden border-4 border-white/20 p-3 -rotate-1 hover:rotate-0 transition-transform duration-300">
                  <div class="rounded overflow-hidden">
                    <img
                      src={~p"/images/history/ysc_origin_story_by_arnold.webp"}
                      alt="Arnold Rolkert's account of founding the YSC in 1950"
                      class="w-full h-full object-cover"
                    />
                  </div>
                </div>

                <blockquote class="border-l-4 border-blue-200 pl-4 italic text-blue-50 mb-4">
                  <p>
                    "On August 19, 1950, Arnold Rolkert gathered a group of friends together including Gunnar Engen, Carlo Hojsgaard, Peter Larsen Bernard, and Ulla Lindberg to form what they called The Young Scandinavians Club of San Francisco."
                  </p>
                </blockquote>

                <%!-- Ledger-style historical detail --%>
                <div class="ledger-callout my-4 rounded">
                  Initial Membership Fee: $5.00 annual dues<br />
                  Charter Members: 30 founding members
                </div>

                <p class="text-blue-50 leading-relaxed">
                  Thirty members attended the club's first general meeting the following January, and Arnold became its first president. This moment marked the birth of a community that would span generations and create countless memories.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1960s Decade Watermark --%>
          <div class="relative">
            <div class="decade-watermark">1960s</div>
          </div>

          <%!-- 1960 - Incorporated --%>
          <div
            data-timeline-item
            data-tags="organization, anniversary"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1960
              </span>
            </div>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-3 h-3 md:w-4 md:h-4 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20">
            </div>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300 overflow-hidden">
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="px-3 py-1 bg-purple-50 text-purple-600 text-xs font-bold uppercase rounded-full">
                    Organization
                  </span>
                  <span class="px-3 py-1 bg-yellow-50 text-yellow-600 text-xs font-bold uppercase rounded-full">
                    Anniversary
                  </span>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                  Incorporated as Non-Profit
                </h3>

                <%!-- Nordic Highlight Frontpage 1960 with archival styling --%>
                <div class="my-4 archival-photo era-1960s rounded-lg overflow-hidden p-3 rotate-1 hover:rotate-0 transition-transform duration-300">
                  <div class="aspect-[3/4] rounded overflow-hidden">
                    <img
                      src={
                        ~p"/images/history/nordic_highlight_1960_frontpage.webp"
                      }
                      alt="Nordic Highlight frontpage from 1960"
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <p class="text-xs text-zinc-500 italic mt-2">
                    Nordic Highlight newsletter from 1960
                  </p>
                </div>

                <p class="text-zinc-600 leading-relaxed">
                  YSC incorporated as a nonprofit organization; 10th anniversary banquet at Canterbury Hotel (anniversaries celebrated every 5 years since); first ski cabin rented at Lake Tahoe.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1961 - Lisa for President --%>
          <div
            data-timeline-item
            data-tags="club leadership"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1961
              </span>
            </div>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-3 h-3 md:w-4 md:h-4 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20">
            </div>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300">
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="px-3 py-1 bg-blue-50 text-blue-600 text-xs font-bold uppercase rounded-full">
                    Club Leadership
                  </span>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                  Lisa for President
                </h3>
                <p class="text-zinc-600 leading-relaxed">
                  Lisa Gille (now Wiborg) begins four-year reign as president. She later serves another year. Started renting current Clear Lake cabin.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1963 - Purchased Clear Lake (MILESTONE - Full Width) --%>
          <div
            data-timeline-item
            data-tags="real estate, cabin life"
            class="relative group z-20"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <%!-- Full-width milestone card --%>
            <div class="w-full relative z-20">
              <div class="bg-gradient-to-br from-orange-50 via-white to-green-50 border-2 border-orange-300 rounded-2xl p-8 md:p-12 shadow-xl group-hover:shadow-2xl transition-all duration-300 overflow-hidden relative">
                <%!-- Year badge in top-left corner --%>
                <div class="absolute top-6 left-6 bg-orange-600 text-white px-4 py-2 rounded-full font-black text-lg shadow-lg">
                  1963
                </div>

                <%!-- Milestone indicator --%>
                <div class="absolute top-6 right-6">
                  <.icon name="hero-home" class="w-8 h-8 text-orange-600" />
                </div>

                <div class="pt-16">
                  <div class="flex flex-wrap gap-2 mb-4">
                    <span class="px-3 py-1 bg-orange-100 text-orange-700 text-xs font-bold uppercase rounded-full border border-orange-300">
                      Real Estate
                    </span>
                    <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-bold uppercase rounded-full border border-green-300">
                      Cabin Life
                    </span>
                    <span class="px-3 py-1 bg-blue-100 text-blue-700 text-xs font-bold uppercase rounded-full border border-blue-300">
                      Major Milestone
                    </span>
                  </div>

                  <h3 class="text-3xl md:text-4xl font-black text-zinc-900 mb-6 leading-tight">
                    The Clear Lake Acquisition
                  </h3>

                  <%!-- Images in grid --%>
                  <div class="grid md:grid-cols-2 gap-6 mb-6">
                    <div class="rounded-lg overflow-hidden shadow-md bg-zinc-100 era-1960s">
                      <div class="aspect-[4/3] overflow-hidden">
                        <img
                          src="/images/history/SAS 1963.webp"
                          alt="YSC members on SAS flight to Scandinavia in 1963"
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <p class="text-xs text-zinc-500 italic mt-2 px-2 pb-2">
                        40 YSC members on their legendary group flight back to Scandinavia
                      </p>
                    </div>

                    <div class="rounded-lg overflow-hidden shadow-md bg-zinc-100 era-2000s">
                      <div class="aspect-[4/3] overflow-hidden">
                        <img
                          src="/images/history/clear_lake_from_above.webp"
                          alt="Aerial view of Clear Lake cabin and dock"
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <p class="text-xs text-zinc-500 italic mt-2 px-2 pb-2">
                        Clear Lake cabin with the 100-foot private dock
                      </p>
                    </div>
                  </div>

                  <p class="text-lg text-zinc-700 leading-relaxed font-medium">
                    Purchased the Clear Lake property for $28,000 with a $10,000 down payment, this move established our first permanent home. That same year, 40 members took a legendary group flight back to Scandinavia.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <%!-- 1964 - Cabin Manager on Board --%>
          <div
            data-timeline-item
            data-tags="club leadership"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1964
              </span>
            </div>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-3 h-3 md:w-4 md:h-4 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20">
            </div>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300">
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="px-3 py-1 bg-blue-50 text-blue-600 text-xs font-bold uppercase rounded-full">
                    Club Leadership
                  </span>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                  Cabin Manager and Activities Director on the Board
                </h3>
                <p class="text-zinc-600 leading-relaxed">
                  Cabin Manager and Activities Director positions elevated to Executive Committee status.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1965 - 15th Anniversary --%>
          <div
            data-timeline-item
            data-tags="anniversary"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1965
              </span>
            </div>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-3 h-3 md:w-4 md:h-4 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20">
            </div>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300 overflow-hidden">
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="px-3 py-1 bg-yellow-50 text-yellow-600 text-xs font-bold uppercase rounded-full">
                    Anniversary
                  </span>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                  15th Anniversary Celebration
                </h3>

                <%!-- 15th Anniversary Image --%>
                <div class="my-4 rounded-lg overflow-hidden era-1960s">
                  <div class="aspect-[4/3] relative">
                    <img
                      src="/images/history/ysc_15th_anniversary.webp"
                      alt="YSC 15th Anniversary celebration"
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <p class="text-xs text-zinc-500 italic mt-2">
                    15th Anniversary banquet celebration
                  </p>
                </div>

                <p class="text-zinc-600 leading-relaxed">
                  YSC celebrates its 15th Anniversary, continuing the tradition of commemorating club milestones every five years with members and friends.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1966 - Improvements to Clear Lake --%>
          <div
            data-timeline-item
            data-tags="cabin life"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1966
              </span>
            </div>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-3 h-3 md:w-4 md:h-4 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20">
            </div>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300">
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="px-3 py-1 bg-green-50 text-green-600 text-xs font-bold uppercase rounded-full">
                    Cabin Life
                  </span>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                  Improvements to Clear Lake
                </h3>
                <p class="text-zinc-600 leading-relaxed">
                  Members make major improvements to Clear Lake property, including septic tank, parking area, and leach field.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1967 - Clear Lake bathroom construction --%>
          <div
            data-timeline-item
            data-tags="cabin life"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1967
              </span>
            </div>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-3 h-3 md:w-4 md:h-4 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20">
            </div>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300">
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="px-3 py-1 bg-green-50 text-green-600 text-xs font-bold uppercase rounded-full">
                    Cabin Life
                  </span>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                  Clear Lake Bathroom Construction
                </h3>
                <p class="text-zinc-600 leading-relaxed">
                  New bathrooms constructed at Clear Lake cabin.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1974 - Clear Lake paid off --%>
          <div
            data-timeline-item
            data-tags="real estate, cabin life"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1974
              </span>
            </div>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-4 h-4 md:w-5 md:h-5 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20 flex items-center justify-center ring-4 ring-blue-100">
              <.icon
                name="hero-check-circle"
                class="w-2 h-2 md:w-3 md:h-3 text-white"
              />
            </div>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300">
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="px-3 py-1 bg-orange-50 text-orange-600 text-xs font-bold uppercase rounded-full">
                    Real Estate
                  </span>
                  <span class="px-3 py-1 bg-green-50 text-green-600 text-xs font-bold uppercase rounded-full">
                    Cabin Life
                  </span>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                  Clear Lake Paid Off
                </h3>
                <p class="text-zinc-600 leading-relaxed">
                  Clear Lake loan paid off. The cabin and it's 3/4 acre lot is ours.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1970s Decade Watermark --%>
          <div class="relative">
            <div class="decade-watermark">1970s</div>
          </div>

          <%!-- Timeline events 1970-1982 --%>
          <%= for {year, title, content, tags, image_path, image_caption} <- [
          {"1970", "20th Anniversary", "On September 26, 1970, YSC celebrates its 20th Anniversary with a grand celebration at Del Webb's Townhouse in San Francisco. In a remarkable show of diplomatic support, all the Consul Generals of the Nordic countries attended—representing Iceland, Norway, Denmark, Sweden, and Finland—marking this as one of the most prestigious events in YSC history.", ["anniversary"], "/images/history/ysc_20th_anniversary.webp", "YSC 20th Anniversary celebration"},
          {"1970s", "Yosemite Adventure", "YSC members embark on memorable outdoor adventures to Yosemite National Park, strengthening bonds through shared experiences in nature.", ["organization"], "/images/history/ysc_yosemite.webp", "YSC members at Yosemite National Park"},
          {"1976", "New pier", "New pier built at Clear Lake.", ["cabin life"], nil, nil},
          {"1980", "New dock", "New floating dock at Clear Lake.", ["cabin life"], nil, nil},
          {"1979-1981", "Clear Lake rebuild", "Formed CL Task Force to rebuild cabin. Produced architectural plans and received bids from contractors for 2-story building, cost $135 to $160K. Plans were dropped due to an existing building moratorium and resulting permit problems. It was decided to renovate instead.", ["cabin life"], nil, nil},
          {"1981-1982", "Major Clear Lake renovations", "Major renovations on Clear Lake cabin, with member Inge Sullivan as key contractor. Total cost $80,000.", ["cabin life"], nil, nil}
        ] do %>
            <% tag_colors = %{
              "cabin life" => "bg-green-50 text-green-600",
              "real estate" => "bg-orange-50 text-orange-600",
              "club leadership" => "bg-blue-50 text-blue-600",
              "anniversary" => "bg-yellow-50 text-yellow-600",
              "organization" => "bg-purple-50 text-purple-600"
            }

            # Determine era class based on year
            era_class =
              cond do
                String.starts_with?(year, "197") or year == "1970s" ->
                  "era-1970s"

                String.starts_with?(year, "198") ->
                  "era-1980s"

                true ->
                  "era-1970s"
              end

            is_milestone = year in ["1993", "2000", "2025"] %>
            <div
              data-timeline-item
              data-tags={Enum.join(tags, ", ")}
              class="relative group"
              phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
              phx-viewport-enter-start="opacity-0 translate-y-8"
              phx-viewport-enter-end="opacity-100 translate-y-0"
            >
              <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
                <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                  {year}
                </span>
              </div>
              <div class={[
                "hidden md:block absolute top-3 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20",
                if(is_milestone,
                  do:
                    "w-4 h-4 md:w-5 md:h-5 left-[7.875rem] lg:left-[9.875rem] ring-4 ring-blue-100",
                  else:
                    "w-3 h-3 md:w-4 md:h-4 left-[7.875rem] lg:left-[9.875rem]"
                )
              ]}>
              </div>
              <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
                <div class={[
                  "rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300 overflow-hidden",
                  if(year == "2025",
                    do:
                      "bg-gradient-to-br from-blue-50 to-blue-100 border-2 border-blue-200",
                    else: "bg-white border border-zinc-200"
                  )
                ]}>
                  <div class="flex flex-wrap gap-2 mb-3">
                    <%= for tag <- tags do %>
                      <span class={[
                        "px-3 py-1 text-xs font-bold uppercase rounded-full",
                        Map.get(tag_colors, tag, "bg-zinc-50 text-zinc-600")
                      ]}>
                        {String.replace(tag, "_", " ")}
                      </span>
                    <% end %>
                  </div>
                  <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                    {title}
                  </h3>

                  <%!-- Historic Image if available --%>
                  <%= if image_path do %>
                    <div class={["my-4 rounded-lg overflow-hidden", era_class]}>
                      <div class="aspect-[4/3] relative">
                        <img
                          src={image_path}
                          alt={image_caption || title || "History image"}
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <%= if image_caption do %>
                        <p class="text-xs text-zinc-500 italic mt-2">
                          {image_caption}
                        </p>
                      <% end %>
                    </div>
                  <% end %>

                  <p class="text-zinc-600 leading-relaxed">
                    {content}
                  </p>
                </div>
              </div>
            </div>
          <% end %>

          <%!-- 1980s Decade Watermark --%>
          <div class="relative">
            <div class="decade-watermark">1980s</div>
          </div>

          <%!-- 1985 - 35th Anniversary --%>
          <div
            data-timeline-item
            data-tags="anniversary"
            class="relative group"
            phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
            phx-viewport-enter-start="opacity-0 translate-y-8"
            phx-viewport-enter-end="opacity-100 translate-y-0"
          >
            <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
              <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                1985
              </span>
            </div>
            <div class="hidden md:block absolute left-[7.875rem] lg:left-[9.875rem] top-3 w-4 h-4 md:w-5 md:h-5 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20 ring-4 ring-blue-100">
            </div>
            <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
              <div class="bg-white border border-zinc-200 rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300 overflow-hidden">
                <div class="flex flex-wrap gap-2 mb-3">
                  <span class="px-3 py-1 bg-yellow-50 text-yellow-600 text-xs font-bold uppercase rounded-full">
                    Anniversary
                  </span>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                  35th Anniversary Celebration
                </h3>

                <%!-- Anniversary Program Images --%>
                <div class="grid md:grid-cols-2 gap-4 my-4">
                  <div class="rounded-lg overflow-hidden era-1980s">
                    <div class="aspect-[3/4] relative">
                      <img
                        src="/images/history/35th_anniversary_program.webp"
                        alt="35th Anniversary celebration program cover"
                        class="w-full h-full object-cover"
                      />
                    </div>
                    <p class="text-xs text-zinc-500 italic mt-2">
                      Anniversary program cover
                    </p>
                  </div>
                  <div class="rounded-lg overflow-hidden era-1980s">
                    <div class="aspect-[3/4] relative">
                      <img
                        src="/images/history/35th_anniversary_program_2.webp"
                        alt="35th Anniversary celebration program inside"
                        class="w-full h-full object-cover"
                      />
                    </div>
                    <p class="text-xs text-zinc-500 italic mt-2">
                      Program details
                    </p>
                  </div>
                </div>

                <p class="text-zinc-600 leading-relaxed">
                  On <strong>November 2, 1985</strong>, YSC celebrates its 35th Anniversary with an elegant celebration at the <strong>St. Francis Yacht Club</strong>, commemorating 35 years of Scandinavian fellowship and tradition.
                </p>
              </div>
            </div>
          </div>

          <%!-- 1990s Decade Watermark --%>
          <div class="relative">
            <div class="decade-watermark">1990s</div>
          </div>

          <%!-- Timeline events 1985-2026 --%>
          <%= for {year, title, content, tags, image_path, image_caption} <- [
          {"1985", "Lucia Celebration", "YSC Lucia celebration captured in this memorable photo.", ["organization"], "/images/history/Lucia 1985 03.webp", "YSC Lucia celebration, 1985"},
          {"1986", "Executive Committee", "The Executive Committee meeting at Clear Lake. New floating docks with steel pilings and sea wall reconstruction completed.", ["cabin life", "club leadership"], "/images/history/Exec Comm 1986.webp", "Executive Committee at Clear Lake, 1986"},
          {"1993", "Tahoe Cabin Purchase", "Tahoe cabin purchased for $190,000.00, marking a major milestone in the club's growth.", ["real estate", "cabin life"], nil, nil},
          {"1996-1999", "New Clear Lake ambitions", "A Bathroom Subcommittee was charged with expanding and remodeling the bathrooms at CL. After ten different design schemes construction drawings were submitted for bidding. The plans incorporated a separate new structure complete with handicapped access and resistant to periodic flooding. At a cost of $106,000 it was decided that we might as well build a whole new cabin. Preliminary drawings for a 2-story structure were made for a presentation at our 50th anniversary. The Bathroom Subcommittee was disbanded in 1999.", ["cabin life"], nil, nil},
          {"1997", "Tahoe Cabin Master on the Board", "Andrew Vik, 24, becomes youngest president in YSC history. Changes made to the bylaws to include Tahoe Cabin Manager on the Executive Committee and the Board of Trustees at six full members (formerly five plus an alternate).", ["club leadership"], nil, nil},
          {"2000_DECADE", "", "", [], nil, nil},
          {"2000", "YSC 50th Anniversary", "YSC celebrates it's 50th anniversary with a grand party at the Sir Francis Drake Hotel. Guest of honor: Arnold Rolkert – the first president, flies in from Sweden and delivers this speech.", ["anniversary"], nil, nil},
          {"2003", "New ski boat", "Clear Lake – Replaced 21 year old Ski Supreme with a brand new Moomba ski boat.", ["cabin life"], nil, nil},
          {"2007", "Clear Lake bathroom remodel", "Bathrooms finally remodeled according to 1982 scheme – move wall to add a toilet and a shower from men's to women's room, and installing two showers in men's room using existing plumbing. Purchase new gas stove, an electric double oven and a refrigerator for the pantry.", ["cabin life"], nil, nil},
          {"2010_DECADE", "", "", [], nil, nil},
          {"2014", "Sauna in Tahoe", "Tahoe Cabin – After a strong fundraising drive by the Tahoe committee, the John Rollings Memorial Sauna is inaugurated in November this year.", ["cabin life"], "/images/history/ysc_tahoe_sauna_tiles.webp", "John Rollings Memorial Sauna at Tahoe"},
          {"2015", "65th Anniversary", "In September, YSC celebrates its 65th Anniversary with a grand black-tie party at the Maritime Museum in San Francisco.", ["anniversary"], "/images/history/7_presidents_65th_anniversary.webp", "Seven YSC presidents at the 65th Anniversary celebration"},
          {"2017", "Clear Lake flooded", "Clear Lake – After several dry years with many wildfires around the lake it is finally raining again. The Clear Lake cabin is again flooded with a foot of water on throughout the cabin.", ["cabin life"], nil, nil},
          {"2019", "Longest serving President", "With six consecutive years, Peter Nordström becomes the longest serving president of the YSC to date.", ["club leadership"], nil, nil},
          {"2020_DECADE", "", "", [], nil, nil},
          {"2020", "Covid-19 Pandemic", "Due to the COVID-19 pandemic, the YSC, (together with most of the world), has to freeze all operations and close our cabins.", ["organization"], nil, nil},
          {"2025", "75 Year Anniversary", "The YSC celebrates its 75th Anniversary with a grand party at the Swedish American Hall in San Francisco.", ["anniversary"], "/images/history/ysc_75th_anniversary.webp", "YSC 75th Anniversary celebration"},
          {"2026", "Peter Nordström Returns as President", "Peter Nordström returns as president of the club after coming back to the board in 2025 as an event coordinator, marking his return to leadership.", ["club leadership"], nil, nil}
        ] do %>
            <% tag_colors = %{
              "cabin life" => "bg-green-50 text-green-600",
              "real estate" => "bg-orange-50 text-orange-600",
              "club leadership" => "bg-blue-50 text-blue-600",
              "anniversary" => "bg-yellow-50 text-yellow-600",
              "organization" => "bg-purple-50 text-purple-600"
            }

            # Determine era class based on year
            era_class =
              cond do
                String.starts_with?(year, "198") -> "era-1980s"
                String.starts_with?(year, "199") -> "era-1990s"
                String.starts_with?(year, "200") -> "era-2000s"
                String.starts_with?(year, "201") -> "era-2010s"
                String.starts_with?(year, "202") -> "era-2020s"
                true -> "era-1980s"
              end

            is_milestone = year in ["1993", "2000", "2025"] %>

            <%!-- Render decade watermark if this is a decade marker --%>
            <%= if String.ends_with?(year, "_DECADE") do %>
              <div class="relative">
                <div class="decade-watermark">
                  {String.replace(year, "_DECADE", "s")}
                </div>
              </div>
            <% else %>
              <%!-- Render milestone events with full-width special treatment --%>
              <%= if is_milestone do %>
                <div
                  data-timeline-item
                  data-tags={Enum.join(tags, ", ")}
                  class="relative group z-20"
                  phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
                  phx-viewport-enter-start="opacity-0 translate-y-8"
                  phx-viewport-enter-end="opacity-100 translate-y-0"
                >
                  <div class="w-full relative z-20">
                    <div class={[
                      "rounded-2xl p-8 md:p-12 shadow-xl group-hover:shadow-2xl transition-all duration-300 overflow-hidden relative border-2",
                      case year do
                        "1993" ->
                          "bg-gradient-to-br from-orange-50 via-white to-green-50 border-orange-300"

                        "2000" ->
                          "bg-gradient-to-br from-amber-50 via-white to-yellow-50 border-amber-300"

                        "2025" ->
                          "bg-gradient-to-br from-blue-50 via-white to-indigo-50 border-blue-300"

                        _ ->
                          "bg-white border-zinc-200"
                      end
                    ]}>
                      <%!-- Year badge --%>
                      <div class={[
                        "absolute top-6 left-6 text-white px-4 py-2 rounded-full font-black text-lg shadow-lg",
                        case year do
                          "1993" -> "bg-orange-600"
                          "2000" -> "bg-amber-600"
                          "2025" -> "bg-blue-600"
                          _ -> "bg-zinc-600"
                        end
                      ]}>
                        {year}
                      </div>

                      <%!-- Milestone indicator --%>
                      <div class="absolute top-6 right-6">
                        <.icon
                          name={
                            case year do
                              "1993" -> "hero-home-modern"
                              "2000" -> "hero-cake"
                              "2025" -> "hero-star"
                              _ -> "hero-sparkles"
                            end
                          }
                          class={[
                            "w-8 h-8",
                            case year do
                              "1993" -> "text-orange-600"
                              "2000" -> "text-amber-600"
                              "2025" -> "text-blue-600"
                              _ -> "text-zinc-600"
                            end
                          ]}
                        />
                      </div>

                      <div class="pt-16">
                        <div class="flex flex-wrap gap-2 mb-4">
                          <%= for tag <- tags do %>
                            <% tag_style =
                              case tag do
                                "cabin life" ->
                                  "bg-green-100 text-green-700 border-green-300"

                                "real estate" ->
                                  "bg-orange-100 text-orange-700 border-orange-300"

                                "club leadership" ->
                                  "bg-blue-100 text-blue-700 border-blue-300"

                                "anniversary" ->
                                  "bg-yellow-100 text-yellow-700 border-yellow-300"

                                "organization" ->
                                  "bg-purple-100 text-purple-700 border-purple-300"

                                _ ->
                                  "bg-zinc-100 text-zinc-700 border-zinc-300"
                              end %>
                            <span class={[
                              "px-3 py-1 text-xs font-bold uppercase rounded-full border",
                              tag_style
                            ]}>
                              {String.replace(tag, "_", " ")}
                            </span>
                          <% end %>
                          <span class="px-3 py-1 bg-purple-100 text-purple-700 text-xs font-bold uppercase rounded-full border border-purple-300">
                            Major Milestone
                          </span>
                        </div>

                        <h3 class="text-3xl md:text-4xl font-black text-zinc-900 mb-6 leading-tight">
                          {title}
                        </h3>

                        <%= if image_path do %>
                          <div class={[
                            "my-6 rounded-lg overflow-hidden shadow-md",
                            era_class
                          ]}>
                            <div class="aspect-[4/3] relative">
                              <img
                                src={image_path}
                                alt={image_caption || title || "History image"}
                                class="w-full h-full object-cover"
                              />
                            </div>
                            <%= if image_caption do %>
                              <p class="text-xs text-zinc-500 italic mt-2 px-2">
                                {image_caption}
                              </p>
                            <% end %>
                          </div>
                        <% end %>

                        <p class="text-lg text-zinc-700 leading-relaxed font-medium">
                          {content}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              <% else %>
                <%!-- Regular timeline items --%>
                <div
                  data-timeline-item
                  data-tags={Enum.join(tags, ", ")}
                  class="relative group"
                  phx-viewport-enter="[[&quot;transition-opacity&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;],[&quot;transition-transform&quot;, &quot;duration-1000&quot;, &quot;ease-out&quot;]]"
                  phx-viewport-enter-start="opacity-0 translate-y-8"
                  phx-viewport-enter-end="opacity-100 translate-y-0"
                >
                  <div class="mb-3 md:mb-0 md:absolute md:left-0 md:top-0 md:w-28 lg:w-36 md:text-right md:pr-6 lg:pr-8">
                    <span class="text-2xl md:text-3xl lg:text-4xl font-black text-zinc-300 group-hover:text-blue-600 transition-colors duration-300">
                      {year}
                    </span>
                  </div>
                  <div class={[
                    "hidden md:block absolute top-3 -translate-x-1/2 bg-blue-600 rounded-full border-4 border-white shadow-lg z-20",
                    if(is_milestone,
                      do:
                        "w-4 h-4 md:w-5 md:h-5 left-[7.875rem] lg:left-[9.875rem] ring-4 ring-blue-100",
                      else:
                        "w-3 h-3 md:w-4 md:h-4 left-[7.875rem] lg:left-[9.875rem]"
                    )
                  ]}>
                  </div>
                  <div class="md:ml-36 lg:ml-44 md:pl-6 lg:pl-8 pb-2">
                    <div class={[
                      "rounded-xl p-6 shadow-sm group-hover:shadow-md transition-all duration-300 overflow-hidden",
                      if(year == "2025",
                        do:
                          "bg-gradient-to-br from-blue-50 to-blue-100 border-2 border-blue-200",
                        else: "bg-white border border-zinc-200"
                      )
                    ]}>
                      <div class="flex flex-wrap gap-2 mb-3">
                        <%= for tag <- tags do %>
                          <span class={[
                            "px-3 py-1 text-xs font-bold uppercase rounded-full",
                            Map.get(tag_colors, tag, "bg-zinc-50 text-zinc-600")
                          ]}>
                            {String.replace(tag, "_", " ")}
                          </span>
                        <% end %>
                      </div>
                      <h3 class="text-xl md:text-2xl font-bold text-zinc-900 mb-2">
                        {title}
                      </h3>

                      <%!-- Historic Image if available --%>
                      <%= if image_path do %>
                        <div class={[
                          "my-4 rounded-lg overflow-hidden",
                          era_class
                        ]}>
                          <div class="aspect-[4/3] relative">
                            <img
                              src={image_path}
                              alt={image_caption || title || "History image"}
                              class="w-full h-full object-cover"
                            />
                          </div>
                          <%= if image_caption do %>
                            <p class="text-xs text-zinc-500 italic mt-2">
                              {image_caption}
                            </p>
                          <% end %>
                        </div>
                      <% end %>

                      <p class="text-zinc-600 leading-relaxed">
                        {content}
                      </p>
                    </div>
                  </div>
                </div>
              <% end %>
              <%!-- end is_milestone check --%>
            <% end %>
            <%!-- end _DECADE check --%>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%!-- YSC Presidents Grid --%>
  <div class="mb-16">
    <div class="prose prose-zinc prose-a:text-blue-600 mb-8 scroll-mt-24">
      <h2 id="presidents">YSC Presidents</h2>
    </div>

    <div class="not-prose">
      <% presidents_by_decade =
        @past_presidents
        |> Enum.group_by(fn {years, _} ->
          years
          |> String.split("-")
          |> List.first()
          |> String.slice(0, 3)
          |> Kernel.<>("0s")
        end)
        |> Enum.sort_by(fn {decade, _} -> decade end) %>
      <%= for {decade, presidents} <- presidents_by_decade do %>
        <div
          class="mb-8 scroll-mt-24"
          id={"presidents-#{String.replace(decade, "s", "")}"}
        >
          <h3 class="text-lg font-bold text-zinc-700 mb-4">{decade}</h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            <%= for {years, president} <- presidents do %>
              <% is_founder =
                String.contains?(president, "Arnold Rolkert") ||
                  String.contains?(president, "Gunnar Engen") ||
                  String.contains?(president, "Carlo Hojsgaard")

              is_longest_serving =
                String.contains?(president, "Peter Nordström")

              is_youngest = String.contains?(president, "Andrew Vik")

              is_clear_lake_purchase =
                String.contains?(president, "Lisa") &&
                  String.contains?(years, "1961")

              is_tahoe_purchase = String.contains?(years, "1993")

              badge_text =
                cond do
                  is_founder -> "Founder"
                  is_longest_serving -> "Longest Serving"
                  is_youngest -> "Youngest"
                  is_clear_lake_purchase -> "Purchased Clear Lake"
                  is_tahoe_purchase -> "Purchased Tahoe"
                  true -> nil
                end

              badge_color =
                cond do
                  is_founder ->
                    "bg-amber-100 text-amber-800 border-amber-300"

                  is_longest_serving ->
                    "bg-purple-100 text-purple-800 border-purple-300"

                  is_youngest ->
                    "bg-green-100 text-green-800 border-green-300"

                  is_clear_lake_purchase ->
                    "bg-orange-100 text-orange-800 border-orange-300"

                  is_tahoe_purchase ->
                    "bg-orange-100 text-orange-800 border-orange-300"

                  true ->
                    ""
                end

              is_tbd =
                String.contains?(president, "TBD") ||
                  String.contains?(years, "present")

              decade_start =
                years
                |> String.split("-")
                |> List.first()
                |> String.to_integer()

              is_historical = decade_start < 1990

              card_bg =
                cond do
                  is_tbd -> "bg-blue-50/50"
                  is_founder -> "bg-amber-50"
                  is_longest_serving -> "bg-purple-50"
                  is_youngest -> "bg-green-50"
                  true -> "bg-zinc-50"
                end

              card_border =
                cond do
                  is_tbd ->
                    "border-2 border-dashed border-blue-300"

                  is_founder ->
                    "border-2 border-amber-400 shadow-lg shadow-amber-200/50 ring-2 ring-amber-100"

                  is_longest_serving ->
                    "border-2 border-purple-400 shadow-lg shadow-purple-200/50 ring-2 ring-purple-100"

                  is_youngest ->
                    "border-2 border-green-300"

                  true ->
                    "border border-zinc-200"
                end

              card_scale =
                cond do
                  is_founder -> "md:scale-110"
                  is_longest_serving -> "md:scale-110"
                  true -> ""
                end %>
              <div class={[
                "p-4 rounded-lg flex flex-col items-center text-center transition-all duration-300 relative group hover:shadow-xl hover:scale-105",
                card_bg,
                card_border,
                card_scale,
                if(is_historical, do: "grayscale hover:grayscale-0", else: "")
              ]}>
                <%!-- Icon badges for special achievements --%>
                <%= if is_founder do %>
                  <div class="absolute top-2 right-2">
                    <.icon name="hero-star" class="w-5 h-5 text-amber-500" />
                  </div>
                <% end %>
                <%= if is_longest_serving do %>
                  <div class="absolute top-2 right-2">
                    <.icon name="hero-trophy" class="w-5 h-5 text-purple-500" />
                  </div>
                <% end %>
                <%= if is_youngest do %>
                  <div class="absolute top-2 right-2">
                    <.icon name="hero-sparkles" class="w-5 h-5 text-green-500" />
                  </div>
                <% end %>
                <%= if is_clear_lake_purchase do %>
                  <div class="absolute top-2 right-2">
                    <.icon name="hero-home" class="w-5 h-5 text-orange-500" />
                  </div>
                <% end %>
                <%= if is_tahoe_purchase do %>
                  <div class="absolute top-2 right-2">
                    <.icon
                      name="hero-home-modern"
                      class="w-5 h-5 text-orange-500"
                    />
                  </div>
                <% end %>
                <span class="text-xs font-bold text-blue-600 uppercase mb-2">
                  {years}
                </span>
                <h4 class="font-bold text-zinc-900 text-sm mb-1 leading-tight">
                  {president}
                </h4>
                <span
                  :if={badge_text}
                  class={[
                    "text-xs px-2 py-0.5 rounded-full mt-1 border font-semibold",
                    badge_color
                  ]}
                >
                  {badge_text}
                </span>

                <%!-- Link to timeline for notable presidents --%>
                <%= if is_founder || is_clear_lake_purchase || is_tahoe_purchase || is_youngest || is_longest_serving do %>
                  <a
                    href="#key-events"
                    class="mt-2 text-xs font-semibold text-blue-600 hover:text-blue-700 hover:underline flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity"
                  >
                    <.icon name="hero-clock" class="w-3 h-3" /> View Timeline
                  </a>
                <% end %>

                <%= if is_tbd do %>
                  <.link
                    navigate={~p"/contact?subject=Board%20of%20Directors"}
                    class="mt-2 text-xs font-semibold text-blue-600 hover:text-blue-700 hover:underline"
                  >
                    Join Us →
                  </.link>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%!-- Legacy CTA with enhanced watermark --%>
  <div class="not-prose">
    <div class="bg-zinc-900 rounded-3xl p-12 lg:p-20 text-center relative overflow-hidden">
      <%!-- Refined "75" watermark with gradient mask for subtle fade --%>
      <div
        class="absolute inset-0 flex items-center justify-center pointer-events-none select-none"
        style="mask-image: radial-gradient(circle at center, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.02) 50%, transparent 80%);"
      >
        <span class="text-[20rem] font-black text-white">
          {div(Date.utc_today().year - 1950, 5) * 5}
        </span>
      </div>

      <div class="relative z-10">
        <h3 class="text-4xl md:text-5xl font-black text-white mb-6 tracking-tight">
          Write the Next Chapter.
        </h3>
        <p class="text-xl text-zinc-400 mb-10 max-w-2xl mx-auto leading-relaxed">
          Our history isn't just about the past—it's about the families and friends who will steward these cabins for the next {div(
            Date.utc_today().year - 1950,
            5
          ) * 5} years.
          <strong class="text-white"> Will you be one of them?</strong>
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <.link
            navigate={~p"/users/register"}
            class="px-10 py-4 bg-blue-600 text-white font-black rounded-2xl hover:bg-blue-700 transition-all hover:scale-105 shadow-xl shadow-blue-600/20"
          >
            Become a Member
          </.link>
          <.link
            navigate={~p"/contact"}
            class="px-10 py-4 bg-white/10 text-white font-bold rounded-2xl border border-white/20 hover:bg-white/20 transition-all backdrop-blur-md"
          >
            Ask a Question
          </.link>
        </div>
      </div>
    </div>
  </div>

  <%!-- Topographic Footer with SVG Map Overlay --%>
  <div class="not-prose mt-16">
    <div class="relative bg-gradient-to-br from-blue-900 via-blue-800 to-zinc-900 rounded-3xl p-12 lg:p-16 overflow-hidden">
      <%!-- SVG Topographic Map Pattern Overlay --%>
      <div class="absolute inset-0 opacity-20">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern
              id="topo-pattern"
              x="0"
              y="0"
              width="200"
              height="200"
              patternUnits="userSpaceOnUse"
            >
              <%!-- Topographic contour lines --%>
              <path
                d="M 0,50 Q 50,45 100,50 T 200,50"
                stroke="white"
                stroke-width="1"
                fill="none"
                opacity="0.3"
              />
              <path
                d="M 0,80 Q 50,75 100,80 T 200,80"
                stroke="white"
                stroke-width="1"
                fill="none"
                opacity="0.25"
              />
              <path
                d="M 0,110 Q 50,105 100,110 T 200,110"
                stroke="white"
                stroke-width="1"
                fill="none"
                opacity="0.2"
              />
              <path
                d="M 0,140 Q 50,135 100,140 T 200,140"
                stroke="white"
                stroke-width="0.5"
                fill="none"
                opacity="0.15"
              />
              <path
                d="M 0,170 Q 50,165 100,170 T 200,170"
                stroke="white"
                stroke-width="0.5"
                fill="none"
                opacity="0.1"
              />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#topo-pattern)" />
        </svg>
      </div>

      <%!-- Cabin Location Markers --%>
      <div class="absolute inset-0 flex items-center justify-around pointer-events-none">
        <%!-- SF Marker (leftmost) --%>
        <div class="flex flex-col items-center opacity-40 hover:opacity-100 transition-opacity pointer-events-auto">
          <div class="relative">
            <.icon name="hero-building-office-2" class="w-8 h-8 text-amber-400" />
          </div>
          <span class="text-xs text-white font-semibold mt-2 bg-black/30 px-2 py-1 rounded">
            San Francisco
          </span>
        </div>

        <%!-- Clear Lake Marker (middle) - positioned higher --%>
        <div class="flex flex-col items-center opacity-40 hover:opacity-100 transition-opacity pointer-events-auto pb-42">
          <div class="relative">
            <.icon
              name="hero-map-pin"
              class="w-8 h-8 text-green-400 animate-pulse"
            />
            <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-green-400 rounded-full">
            </div>
          </div>
          <span class="text-xs text-white font-semibold mt-2 bg-black/30 px-2 py-1 rounded">
            Clear Lake
          </span>
        </div>

        <%!-- Tahoe Marker (rightmost) --%>
        <div class="flex flex-col items-center opacity-40 hover:opacity-100 transition-opacity pointer-events-auto">
          <div class="relative">
            <.icon
              name="hero-map-pin"
              class="w-8 h-8 text-blue-400 animate-pulse"
            />
            <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-blue-400 rounded-full">
            </div>
          </div>
          <span class="text-xs text-white font-semibold mt-2 bg-black/30 px-2 py-1 rounded">
            Tahoe
          </span>
        </div>
      </div>

      <%!-- Footer Content --%>
      <div class="relative z-10 text-center">
        <h4 class="text-2xl md:text-3xl font-black text-white mb-4">
          From the City to the Mountains
        </h4>
        <p class="text-lg text-blue-200 max-w-2xl mx-auto leading-relaxed">
          Since 1950, YSC has connected Scandinavian families across Northern California—from our San Francisco roots to the shores of Clear Lake and the peaks of Tahoe.
        </p>
        <div class="mt-8 flex flex-wrap gap-4 justify-center text-sm text-blue-200">
          <a href="#key-events" class="hover:text-white transition-colors">
            ↑ Back to Timeline
          </a>
          <span>•</span>
          <.link
            navigate={~p"/bookings/clear-lake"}
            class="hover:text-white transition-colors"
          >
            Clear Lake Cabin
          </.link>
          <span>•</span>
          <.link
            navigate={~p"/bookings/tahoe"}
            class="hover:text-white transition-colors"
          >
            Tahoe Cabin
          </.link>
          <span>•</span>
          <.link
            navigate={~p"/board"}
            class="hover:text-white transition-colors"
          >
            Board & Leadership
          </.link>
        </div>
      </div>
    </div>
  </div>
</div>
