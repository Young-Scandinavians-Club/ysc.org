<div class="max-w-sm mx-auto py-4 px-4">
  <.link
    href={~p"/"}
    class="flex items-center text-center justify-center py-8 hover:opacity-80 transition duration-200 ease-in-out"
  >
    <.ysc_logo class="h-28" width={112} height={112} fetchpriority="high" />
  </.link>
  <.header class="text-center">
    Open the YSC Admin app
    <:subtitle>
      Your browser is already signed in. Continue only if you opened this page from the YSC Admin app.
    </:subtitle>
  </.header>

  <form
    id="mobile-handoff-form"
    method="post"
    action={~p"/users/log-in/mobile-handoff"}
    class="pt-8 space-y-3"
  >
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <.button
      type="submit"
      name="intent"
      value="continue"
      id="mobile-handoff-continue"
      class="w-full"
    >
      Continue to the app <.icon name="hero-arrow-right" class="w-5 h-5 ms-1" />
    </.button>
    <.button
      type="submit"
      name="intent"
      value="cancel"
      id="mobile-handoff-cancel"
      class="w-full"
      variant="outline"
      color="zinc"
    >
      Cancel
    </.button>
  </form>
</div>
