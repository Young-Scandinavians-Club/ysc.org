<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Signing in…</title>
  </head>
  <body>
    <form id="token-login-form" method="post" action={@action}>
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="token" value={@token} />
      <%= if @redirect_to && @redirect_to != "" do %>
        <input type="hidden" name="redirect_to" value={@redirect_to} />
      <% end %>
      <%= if @mobile_redirect_uri && @mobile_redirect_uri != "" do %>
        <input
          type="hidden"
          name="mobile_redirect_uri"
          value={@mobile_redirect_uri}
        />
      <% end %>
      <noscript>
        <p>
          <button type="submit">Continue signing in</button>
        </p>
      </noscript>
    </form>
    <script>
      document.getElementById("token-login-form").submit();
    </script>
  </body>
</html>
