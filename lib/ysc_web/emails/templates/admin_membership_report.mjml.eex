<mj-section background-color="#fff" border-radius="6px 6px 0px 0px" padding="48px">
  <mj-column padding="0">
    <mj-text color="#000000" font-size="28px" line-height="1.25" padding="0px">
      <strong>Membership Report</strong>
    </mj-text>
    <mj-spacer height="8px"></mj-spacer>
    <mj-text font-size="16px" color="#666666" padding="0px">
      Period: <%= @date_from %> to <%= @date_to %>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section background-color="#fff" padding-left="48px" padding-right="48px" padding-bottom="16px">
  <mj-column padding="0">
    <mj-text font-size="18px" font-weight="700" padding="0px">Summary</mj-text>
    <mj-spacer height="16px"></mj-spacer>
    <mj-table font-size="15px" cellpadding="10px" border="1px solid #e4e4e7">
      <tr style="background-color: #f4f4f5; font-weight: 600;">
        <td>Category</td>
        <td style="text-align: right;">Count</td>
      </tr>
      <tr>
        <td>Applications submitted</td>
        <td style="text-align: right;"><%= @count_applied %></td>
      </tr>
      <tr style="background-color: #f4f4f5;">
        <td>Accepted</td>
        <td style="text-align: right;"><%= @count_accepted %></td>
      </tr>
      <tr>
        <td>Rejected</td>
        <td style="text-align: right;"><%= @count_rejected %></td>
      </tr>
      <tr style="background-color: #f4f4f5;">
        <td>Still pending review</td>
        <td style="text-align: right;"><%= @count_pending %></td>
      </tr>
      <tr>
        <td>Memberships expired</td>
        <td style="text-align: right;"><%= @count_expired %></td>
      </tr>
      <tr style="background-color: #f4f4f5;">
        <td>Memberships purchased</td>
        <td style="text-align: right;"><%= @count_purchased %></td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
<mj-section background-color="#fff" padding-left="48px" padding-right="48px" padding-bottom="48px">
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text font-size="15px" color="#52525b" padding="0px">
      Generated by <%= @generated_by %>. Open the admin panel to view the full report with application details and download a CSV.
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-button href="<%= @report_url %>" background-color="#1447e6" color="#ffffff" align="center" font-size="16px" border-radius="4px" inner-padding="12px 24px">
      View Full Report →
    </mj-button>
  </mj-column>
</mj-section>
