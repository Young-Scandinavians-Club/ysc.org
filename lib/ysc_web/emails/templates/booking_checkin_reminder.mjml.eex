<mj-section background-color="#fff" border-radius="6px 6px 0px 0px" padding-bottom="24px" padding-left="48px" padding-right="48px" padding-top="48px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text color="#000000" font-size="32px" line-height="1.25" padding="0px">
      <strong>Your Stay is Almost Here!</strong>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section background-color="#fff" border-radius="0px 0px 6px 6px" padding-bottom="48px" padding-left="48px" padding-right="48px" padding-top="20px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Hej <%= @first_name %>,</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Your stay at our <%= @property_name %> property is <%= cond do %><% @days_until_checkin == 0 -> %>today<% @days_until_checkin == 1 -> %>tomorrow<% true -> %><%= "#{@days_until_checkin} days away" %><% end %>! We're excited to host you.</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <!-- Door Code Notice - Very Prominent -->
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <div class="door-code-box">
        <strong class="door-code-title">Your Door Code</strong>
        <span class="door-code-value"><%= @door_code %></span>
        <span class="door-code-note">Please save this code - you'll need it to access the property.</span>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <!-- Property Location -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Property Location</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Property:</strong> <%= @property_name %>
    </mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Address:</strong> <%= @property_address %>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <!-- Check-in and Check-out Times -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Check-in & Check-out Times</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Check-in:</strong> <%= @checkin_date %> at <strong><%= @checkin_time %></strong>
    </mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Check-out:</strong> <%= @checkout_date %> at <strong><%= @checkout_time %></strong>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <!-- Reservation Details -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Reservation Details</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Booking Reference:</strong>
      <span class="booking-reference-badge">
        <%= @booking_reference_id %>
      </span>
    </mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Booking Type:</strong> <%= @booking_mode %>
    </mj-text>
    <%= if @room_names do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Room(s):</strong> <%= @room_names %>
    </mj-text>
    <% end %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Duration:</strong> <%= @nights %> <%= if @nights == 1, do: "night", else: "nights" %>
    </mj-text>
    <%= if @is_buyout do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <div class="buyout-text">
        <strong>Entire cabin:</strong> You have the whole cabin to yourself for these dates.
      </div>
    </mj-text>
    <% else %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <%
        adults_count = @guests_count - (@children_count || 0)
        total_guests = @guests_count
      %>
      <strong>Guests:</strong>
      <%= if adults_count > 0 do %>
        <%= adults_count %> <%= if adults_count == 1, do: "adult", else: "adults" %>
      <% end %>
      <%= if (@children_count || 0) > 0 do %>
        <%= if adults_count > 0, do: ", ", else: "" %><%= @children_count %> <%= if @children_count == 1, do: "child", else: "children" %>
      <% end %>
      <span class="gray-text"> (Total: <%= total_guests %> <%= if total_guests == 1, do: "guest", else: "guests" %>)</span>
    </mj-text>
    <% end %>
    <mj-spacer height="24px"></mj-spacer>

    <!-- Tahoe-Specific Information -->
    <%= if @property == "tahoe" do %>
    <!-- Essentials -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">What to Bring</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        Please bring your own:
        <ul class="email-list">
          <li class="email-list-item">Top and bottom sheets (Single or Queen)</li>
          <li class="email-list-item">Warm comforters or sleeping bags (Cabin comforters are decorative only)</li>
          <li class="email-list-item">Pillows and Towels</li>
          <li class="email-list-item-last">Newspaper for fire starting</li>
        </ul>
        <br/>
        <em>Note: Bringing your own bedding means you won't have to do laundry before you leave!</em>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>

    <!-- Critical Warnings -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold" color="#DC2626">Critical Warnings</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="red-alert-box">
        <strong class="strong-block">BEARS ARE ACTIVE ALL YEAR.</strong> They will get in your car. Lock your car doors ALWAYS.<br/><br/>
        <strong class="strong-block">No Pets Allowed. No Exceptions.</strong><br/>
        <strong class="strong-block">Guests &amp; Reservations</strong>
        Ensure your reservation for the number of adults staying is accurate. Guests must be accompanied by a Member. Members are responsible for ensuring guests know the cabin policies.<br/><br/>
        <strong class="strong-block">The Bear Wire</strong>
        <strong>Check Status:</strong> The box to the right of the front door should be clicking. If not, reset it in the fuse box in the laundry room (marked "BW").<br/>
        <strong>To Deactivate:</strong> Remove top wire first, then 2nd, then 3rd.<br/>
        <strong>To Reactivate:</strong> Hook bottom wire first, then 2nd, then top.<br/>
        <strong>IMPORTANT:</strong> Make sure all three outside doors have bear wire UP when leaving the cabin and at night.<br/><br/>
        <strong class="strong-block">WINTER PARKING RESTRICTION — NOV 1 – MAY 1</strong>
        <strong class="strong-block">NO STREET PARKING ALLOWED</strong>
        Towing is strictly enforced for snow removal and carries massive financial penalties. You WILL be towed if parked on the street during winter months.
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>

    <!-- While You're There -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">While You're There</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        <ul class="email-list">
          <li class="email-list-item"><strong>Neighborhood etiquette:</strong> Drive slowly. No outside/deck noise after 10:00 PM.</li>
          <li class="email-list-item"><strong>Parking:</strong> Do not park in front of neighbors' driveways. Park within the white stripe to leave room for others.</li>
          <li class="email-list-item"><strong>Clean your space:</strong> Scrub, vacuum, and tidy your rooms, bathrooms, and kitchen before leaving.</li>
          <li class="email-list-item"><strong>Ski gear:</strong> Keep ski boots in the laundry room and skis outside.</li>
          <li class="email-list-item"><strong>Firewood:</strong> Leave wood and kindling for the next members. Chop only at the wood pile.</li>
          <li class="email-list-item"><strong>Thermostat:</strong> Set to 50°F at night and when leaving.</li>
          <li class="email-list-item"><strong>Final check:</strong> Close front blinds, turn lights out, and verify bear wire is active.</li>
          <li class="email-list-item"><strong>Food:</strong> ALL food must be removed from the cabin and secured in the outside Bear Box at the street.</li>
          <li class="email-list-item"><strong>Trash schedule:</strong> Set out by Tuesday evening for early Wednesday pickup. Do not park in front of the bear box on Wed mornings.</li>
          <li class="email-list-item"><strong>Recycling:</strong> Use BLUE trash bags for mixed recycling. Place them inside the bear box next to the cans (not inside the cans).</li>
          <li class="email-list-item-last"><strong>If trash is full:</strong> You may need to take trash home. In winter, help remove snow for pickup. Ensure the bear box is completely closed.</li>
        </ul>
        <br/>
        <em>Full chore details are also posted inside the cabin.</em>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        If it's broken, fix it. If it's messy, clean it. This is your cabin—the better we take care of it, the better we will like being there.<br/><br/>
        Let the Cabin Master know if anything is unrepaired or needed.
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <% end %>

    <!-- Clear Lake-Specific Information -->
    <%= if @property == "clear_lake" do %>
    <!-- Essentials -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Getting In & What to Bring</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        <ul class="email-list">
          <li class="email-list-item"><strong>Lockbox:</strong> Left side of the single entry door (as you walk across the main grass area). There are 4 keys — use them to open all doors and pool storage.</li>
          <li class="email-list-item"><strong>What to bring:</strong> Sleeping bag, pillow, towels, tent (if needed).</li>
          <li class="email-list-item"><strong>Mats:</strong> Sleeping mats are available in the storage room next to the pool toy room. Sanitize/wipe down before and after use. Stack neatly upon departure.</li>
          <li class="email-list-item"><strong>Parking:</strong> Park parallel in the lot along the water line. Do not block the driveway or neighbors' spots.</li>
          <li class="email-list-item-last"><strong>Garbage:</strong> Please dispose of any trash in the appropriate dumpster before you leave. The code for the padlocks on the dumpsters is <strong>1982</strong>.</li>
        </ul>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>

    <!-- Critical Warnings -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold" color="#DC2626">Critical Warnings</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="red-alert-box">
        <ul class="email-list">
          <li class="email-list-item"><strong>MANDATORY:</strong> Please watch the <a href="<%= @clear_lake_info_url %>" class="email-link">Clear Lake training videos</a> (8 short videos) before arrival.</li>
          <li class="email-list-item-last"><strong>No Pets:</strong> No dogs, cats, or other pets allowed.</li>
        </ul>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>

    <!-- While You're There -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">While You're There</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        <ul class="email-list">
          <li class="email-list-item"><strong>Lock everything when leaving:</strong> the Cabin, the Pantry, the Pool Room, and Men's & Women's Bathrooms. Return all 4 keys to the lockbox.</li>
          <li class="email-list-item"><strong>Sprinklers (Thursday mornings):</strong> If staying Wed–Thu, move sleeping arrangements off the lawn to the deck or concrete patio. Do not let belongings get water damaged.</li>
          <li class="email-list-item"><strong>Water:</strong> Use the spigot by the lawn entry gate for hosing down the deck or filling pools (non-drinkable). All other spigots are potable — do not waste fresh water.</li>
          <li class="email-list-item"><strong>Sanitize:</strong> Sanitize surfaces, range top, ovens, and counters before and after use. Wash all dishes and utensils.</li>
          <li class="email-list-item"><strong>Dishwasher:</strong> Empty BEFORE departure.</li>
          <li class="email-list-item"><strong>Supplies:</strong> Under the kitchen sink and behind the men's bathroom entry door. Report low cleaning supplies/sanitizer to the Cabin Master.</li>
          <li class="email-list-item-last"><strong>Opening & Closing checklists:</strong> In the Cabin Master Room, find the printed "OPENING" and "CLOSING" checklists and use them to properly open up and shut down the cabin.</li>
        </ul>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        Please be considerate of others. It is everyone's responsibility to keep the cabin clean and inviting.<br/><br/>
        Enjoy your stay!
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <% end %>

    <!-- View Booking Button -->
    <mj-button href="<%= @booking_url %>" css-class="btn_block" inner-padding="15px" width="100%" background-color="#1447e6" color="#ffffff" align="center" font-size="18px" border-radius="4px">View Booking Details →</mj-button>
    <mj-spacer height="24px"></mj-spacer>
    <!-- Cabin Master Contact -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Questions or Need Help?</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">If you have any questions or need help, please reach out to the Cabin Master:</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <%= if @cabin_master_name do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Cabin Master:</strong> <%= @cabin_master_name %>
    </mj-text>
    <% end %>
    <%= if @cabin_master_email do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Email:</strong>&nbsp;<a href="mailto:<%= @cabin_master_email %>" class="email-link"><%= @cabin_master_email %></a>
    </mj-text>
    <% end %>
    <%= if @cabin_master_phone do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Phone:</strong>&nbsp;<a href="tel:<%= @cabin_master_phone %>" class="email-link"><%= @cabin_master_phone %></a>
    </mj-text>
    <% end %>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">We look forward to hosting you at our <%= @property_name %> property!</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Vi ses snart! (See you soon!) 👋</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Young Scandinavians Club</mj-text>
    <mj-spacer height="12px"></mj-spacer>
  </mj-column>
</mj-section>
