<mj-section background-color="#fff" border-radius="6px 6px 0px 0px" padding-bottom="24px" padding-left="48px" padding-right="48px" padding-top="48px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text color="#000000" font-size="32px" line-height="1.25" padding="0px">
      <strong>Checkout Reminder</strong>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section background-color="#fff" border-radius="0px 0px 6px 6px" padding-bottom="48px" padding-left="48px" padding-right="48px" padding-top="20px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Hej <%= @first_name %>,</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Your stay at our <%= @property_name %> property is coming to an end. Please review the checkout instructions below to ensure a smooth departure.</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <!-- Leave by -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Leave By</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Check-out:</strong> <%= @checkout_date %> at <strong><%= @checkout_time %></strong>
    </mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Booking Reference:</strong>
      <span class="booking-reference-badge">
        <%= @booking_reference_id %>
      </span>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>

    <!-- Tahoe-Specific Checkout Instructions -->
    <%= if @property == "tahoe" do %>
    <!-- Critical — do not skip -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold" color="#DC2626">Do Not Skip</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="red-alert-box">
        <ul class="email-list">
          <li class="email-list-item"><strong>Bearproof lids:</strong> Apply bearproof lids to garbage cans at all times.</li>
          <li class="email-list-item"><strong>Food secured:</strong> ALL food must be removed from the cabin and secured in the outside Bear Box at the street. Do not leave food in the refrigerator.</li>
          <li class="email-list-item"><strong>Bear wire UP:</strong> Make sure all three outside doors have bear wire UP when leaving.</li>
          <li class="email-list-item-last"><strong>Thermostat:</strong> Set to 50°F when leaving.</li>
        </ul>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>

    <!-- Cleaning checklist -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Before You Leave</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        This is your cabin, not a hotel. Cabin rates can remain low with your help — please clean up after yourselves.<br/><br/>
        <ul class="email-list">
          <li class="email-list-item"><strong>Rooms:</strong> Clean rooms and strip beds.</li>
          <li class="email-list-item"><strong>Club Bedding:</strong> If club bedding was used, wash, dry, and put it away.</li>
          <li class="email-list-item"><strong>Kitchen:</strong> Leave kitchen spotless.</li>
          <li class="email-list-item"><strong>Bathrooms & common areas:</strong> Must be cleaned.</li>
          <li class="email-list-item"><strong>Final check:</strong> Close front blinds and ensure lights are out.</li>
          <li class="email-list-item-last"><strong>Supplies:</strong> Vacuum and cleaning supplies are in the "Boiler Room" downstairs. Bathroom cleaning supplies are in the sink cabinets in each bathroom.</li>
        </ul>
        <br/>
        <em>Full chore details are also posted inside the cabin.</em>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        If it's broken, fix it. If it's messy, clean it. This is your cabin—the better we take care of it, the better we will like being there.<br/><br/>
        Let the Cabin Master know if anything is unrepaired or needed.
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <% end %>

    <!-- Clear Lake-Specific Checkout Instructions -->
    <%= if @property == "clear_lake" do %>
    <!-- Critical — do not skip -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold" color="#DC2626">Do Not Skip</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="red-alert-box">
        <strong class="strong-block">Lock everything when leaving:</strong>
        <ul class="email-list">
          <li class="email-list-item">The Cabin</li>
          <li class="email-list-item">The Pantry</li>
          <li class="email-list-item">The Pool Room</li>
          <li class="email-list-item-last">Men's & Women's Bathrooms</li>
        </ul>
        <br/>
        <strong>Return Keys:</strong> Place all 4 keys back in the lockbox on the left side of the single entry door.
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>

    <!-- Closing checklist -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Before You Leave</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        <ul class="email-list">
          <li class="email-list-item"><strong>Deep Clean:</strong> Sanitize range top, ovens, and counter tops.</li>
          <li class="email-list-item"><strong>Dishwasher:</strong> Empty BEFORE departure.</li>
          <li class="email-list-item"><strong>All Dishes:</strong> Wash and put away all dishes and utensils.</li>
          <li class="email-list-item"><strong>Sleeping Mats:</strong> Sanitize/wipe down and stack neatly in the storage room next to the pool toy room.</li>
          <li class="email-list-item-last"><strong>Closing checklist:</strong> In the Cabin Master Room, find the printed "CLOSING" checklist and use it to properly shut down the cabin.</li>
        </ul>
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.6" padding="0px">
      <div class="gray-alert-box">
        Please be considerate of others. It is everyone's responsibility to keep the cabin clean and inviting.<br/><br/>
        Thank you for staying!
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <% end %>

    <!-- View Booking Button -->
    <mj-button href="<%= @booking_url %>" css-class="btn_block" inner-padding="15px" width="100%" background-color="#1447e6" color="#ffffff" align="center" font-size="18px" border-radius="4px">View Booking Details →</mj-button>
    <mj-spacer height="24px"></mj-spacer>
    <!-- Cabin Master Contact -->
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Questions or Need Help?</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">If you have any questions or need help, please reach out to the Cabin Master:</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <%= if @cabin_master_name do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Cabin Master:</strong> <%= @cabin_master_name %>
    </mj-text>
    <% end %>
    <%= if @cabin_master_email do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Email:</strong>&nbsp;<a href="mailto:<%= @cabin_master_email %>" class="email-link"><%= @cabin_master_email %></a>
    </mj-text>
    <% end %>
    <%= if @cabin_master_phone do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Phone:</strong>&nbsp;<a href="tel:<%= @cabin_master_phone %>" class="email-link"><%= @cabin_master_phone %></a>
    </mj-text>
    <% end %>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Thank you for staying at our <%= @property_name %> property!</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Young Scandinavians Club</mj-text>
    <mj-spacer height="12px"></mj-spacer>
  </mj-column>
</mj-section>
