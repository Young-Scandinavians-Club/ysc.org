<mj-section background-color="#fff" border-radius="6px 6px 0px 0px" padding-bottom="24px" padding-left="48px" padding-right="48px" padding-top="48px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text color="#000000" font-size="32px" line-height="1.25" padding="0px">
      <strong>Booking Updated</strong>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section background-color="#fff" border-radius="0px 0px 6px 6px" padding-bottom="48px" padding-left="48px" padding-right="48px" padding-top="20px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Hej <%= @first_name %>,</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Your booking has been successfully updated. Below are your new stay details.</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <div class="yellow-alert-box">
        <strong>Refund policy:</strong> Because this booking was modified, cancellation refunds no longer apply if you cancel later.
      </div>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <%= if @dates_changed || @guests_changed do %>
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">What Changed</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <%= if @dates_changed do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Dates:</strong> <%= @previous.checkin_date %> – <%= @previous.checkout_date %> → <%= @booking.checkin_date %> – <%= @booking.checkout_date %>
    </mj-text>
    <% end %>
    <%= if @guests_changed do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Guests:</strong> <%= YscWeb.BookingDisplay.guests_label(@previous.guests_count, @previous.children_count) %> → <%= YscWeb.BookingDisplay.guests_label(@booking.guests_count, @booking.children_count) %>
    </mj-text>
    <% end %>
    <mj-spacer height="24px"></mj-spacer>
    <% end %>
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Updated Stay Details</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Booking Reference:</strong>
      <span style="background-color: #DBEAFE; color: #1E40AF; font-weight: 500; padding: 4px 8px; border-radius: 4px; font-size: 12px; margin-left: 8px;">
        <%= @booking.reference_id %>
      </span>
    </mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Property:</strong> <%= @booking.property %>
    </mj-text>
    <%= if @booking.room_names do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Room(s):</strong> <%= @booking.room_names %>
    </mj-text>
    <% end %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Check-in:</strong> <%= @booking.checkin_date %> (<%= YscWeb.BookingDisplay.checkin_time_label() %>)
    </mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Check-out:</strong> <%= @booking.checkout_date %> (<%= YscWeb.BookingDisplay.checkout_time_label() %>)
    </mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Duration:</strong> <%= YscWeb.BookingDisplay.nights_label(@booking.nights) %>
    </mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Guests:</strong> <%= YscWeb.BookingDisplay.guests_label(@booking.guests_count, @booking.children_count) %>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Payment</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Updated Total:</strong> <span style="color: #059669; font-weight: bold; margin-left: 8px;"><%= @booking.total_amount %></span>
    </mj-text>
    <%= if @additional_payment do %>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong>Additional Amount Charged:</strong> <%= @additional_payment %>
    </mj-text>
    <% end %>
    <mj-spacer height="24px"></mj-spacer>
    <mj-button href="<%= @booking_url %>" css-class="btn_block" inner-padding="15px" width="100%" background-color="#1447e6" color="#ffffff" align="center" font-size="18px" border-radius="4px">View Updated Booking →</mj-button>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">If you have any questions about your updated booking, please contact the Cabin Master or reach out to us at <a href="mailto:info@ysc.org">info@ysc.org</a>.</mj-text>
  </mj-column>
</mj-section>
