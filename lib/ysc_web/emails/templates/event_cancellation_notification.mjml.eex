<mj-section background-color="#fff" border-radius="6px 6px 0px 0px" padding="48px 48px 24px 48px">
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text color="#000000" font-size="32px" line-height="1.25" padding="0px">
      <strong>Cancelled: <%= @event.title %></strong>
    </mj-text>
  </mj-column>
</mj-section>
<%= if @event_image_url do %>
<mj-section background-color="#fff" padding="0px 48px">
  <mj-column padding="0">
    <mj-image src="<%= @event_image_url %>" alt="<%= @event.title %>" border-radius="8px" padding="0px"></mj-image>
  </mj-column>
</mj-section>
<% end %>
<mj-section background-color="#fff" border-radius="0px 0px 6px 6px" padding="20px 48px 48px 48px">
  <mj-column padding="0">
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Hej <%= @first_name %>,</mj-text>
    <mj-spacer height="20px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      We're sorry to let you know that <strong><%= @event.title %></strong> has been cancelled.
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="16px" line-height="1.6" padding="12px 16px" color="#333333" container-background-color="#f9fafb">
      <%= if @event_date_time do %>
      <strong>📅 Was scheduled for:</strong> <%= @event_date_time %><br />
      <% end %>
      <%= if @event.location_name do %>
      <strong>📍 Location:</strong> <%= @event.location_name %><br />
      <% end %>
      <%= if @event.address do %>
      <span style="color: #6B7280; font-size: 14px;"><%= @event.address %></span><br />
      <% end %>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="20px" line-height="1.5" padding="0px">
      <strong>What happens next?</strong>
    </mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">• The event will not take place, and your ticket will no longer be valid.</mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">• If you paid for your ticket, you'll get a separate email once your refund has been processed.</mj-text>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">• If you have any questions, reach out to us at <a href="mailto:<%= @events_email %>"><%= @events_email %></a>.</mj-text>
    <mj-spacer height="32px"></mj-spacer>
    <mj-button href="<%= @upcoming_events_url %>" css-class="btn_block" inner-padding="16px 32px" width="100%" background-color="#1447e6" color="#ffffff" align="center" font-size="18px" font-weight="bold" border-radius="6px">
      Browse upcoming events →
    </mj-button>
    <mj-spacer height="32px"></mj-spacer>
    <mj-text align="left" font-size="16px" line-height="1.5" padding="0px" color="#555555">
      Thank you for your understanding. We hope to see you at another event soon.
    </mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="16px" line-height="1.5" padding="0px" color="#555555">
      <strong>Young Scandinavians Club</strong>
    </mj-text>
  </mj-column>
</mj-section>
