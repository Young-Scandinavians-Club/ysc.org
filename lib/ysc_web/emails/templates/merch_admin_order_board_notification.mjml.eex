<mj-section background-color="#fff" border-radius="6px 6px 0px 0px" padding-bottom="24px" padding-left="48px" padding-right="48px" padding-top="48px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text color="#1447e6" font-size="32px" line-height="1.25" padding="0px">
      <strong>Club-paid merch order</strong>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section background-color="#fff" border-radius="0px 0px 6px 6px" padding-bottom="48px" padding-left="48px" padding-right="48px" padding-top="20px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Dear YSC Board Members,</mj-text>
    <mj-spacer height="16px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <%= if @placed_by.url do %><a href="<%= @placed_by.url %>"><strong><%= @placed_by.name %></strong></a><% else %><strong><%= @placed_by.name %></strong><% end %>
      placed a merch order that the club is paying for (<strong><%= @order.reference_id %></strong>).
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="20px" line-height="1.5" padding="0px" font-weight="bold">Order details</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px" background-color="#f8f9fa" border-radius="4px" padding="16px">
      <strong>Placed by:</strong> <%= @placed_by.name %><%= if @placed_by.email do %> (<%= @placed_by.email %>)<% end %><br/>
      <strong>For:</strong> <%= @recipient.name %>, <%= @recipient.detail %><br/>
      <strong>Ship to:</strong> <%= Enum.join(@address_lines, ", ") %><br/>
      <strong>Why:</strong> <%= @purpose %><br/>
      <%= if @event do %><strong>Event:</strong> <a href="<%= @event.url %>"><%= @event.title %></a><br/><% end %>
      <strong>Estimated cost to the club:</strong> <%= @estimated_cost %>
    </mj-text>
    <mj-spacer height="16px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px"><strong>Items</strong></mj-text>
    <mj-spacer height="8px"></mj-spacer>
    <mj-table padding="0">
      <%= YscWeb.Emails.MerchItems.rows(@items) %>
    </mj-table>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="16px" line-height="1.5" padding="0px" color="#52525b">
      Printful charges the club's card when it accepts the order. The estimate is Printful's quote at placement; the final charge appears on the order once Printful confirms it.
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-button href="<%= @order_url %>" css-class="btn_block" inner-padding="15px" width="100%" background-color="#1447e6" color="#ffffff" align="center" font-size="18px" border-radius="4px">View the order →</mj-button>
    <mj-spacer height="36px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Young Scandinavians Club</mj-text>
    <mj-spacer height="12px"></mj-spacer>
  </mj-column>
</mj-section>
