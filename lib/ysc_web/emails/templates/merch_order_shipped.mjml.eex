<mj-section background-color="#fff" border-radius="6px 6px 0px 0px" padding-bottom="24px" padding-left="48px" padding-right="48px" padding-top="48px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text color="#000000" font-size="32px" line-height="1.25" padding="0px">
      <strong>Your merch is on its way</strong>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section background-color="#fff" border-radius="0px 0px 6px 6px" padding-bottom="48px" padding-left="48px" padding-right="48px" padding-top="20px" padding="48px">
  <mj-column padding="0">
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Hej <%= @first_name %>,</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <%= if @shipment.reshipment do %>
      A replacement for order
      <% else %>
      Good news: order
      <% end %>
      <span style="background-color: #DBEAFE; color: #1E40AF; font-weight: 500; padding: 4px 8px; border-radius: 4px; font-size: 12px;"><%= @order.reference_id %></span>
      has shipped.
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Tracking</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <%= if @shipment.carrier do %><strong>Carrier:</strong> <%= @shipment.carrier %><%= if @shipment.service do %> (<%= @shipment.service %>)<% end %><br /><% end %>
      <%= if @shipment.tracking_number do %><strong>Tracking number:</strong> <%= @shipment.tracking_number %><% else %>The carrier hasn't shared a tracking number yet.<% end %>
    </mj-text>
    <%= if @shipment.tracking_url do %>
    <mj-spacer height="24px"></mj-spacer>
    <mj-button href="<%= @shipment.tracking_url %>" css-class="btn_block" inner-padding="15px" width="100%" background-color="#1447e6" color="#ffffff" align="center" font-size="18px" border-radius="4px">Track your package →</mj-button>
    <% end %>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Your order</mj-text>
    <mj-spacer height="8px"></mj-spacer>
    <mj-table padding="0">
      <%= YscWeb.Emails.MerchItems.rows(@items) %>
    </mj-table>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold">Shipping to</mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <strong><%= @ship_to.name %></strong><br />
      <%= for line <- @ship_to.lines do %><%= line %><br /><% end %>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px"><%= if @delivery_estimate do %><strong>Estimated delivery: <%= @delivery_estimate %>.</strong><% else %>Delivery usually takes a few business days.<% end %> Questions? Reach out to us at <a href="mailto:info@ysc.org">info@ysc.org</a>.</mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-button href="<%= @order_url %>" css-class="btn_block" inner-padding="15px" width="100%" background-color="#1447e6" color="#ffffff" align="center" font-size="18px" border-radius="4px">View your order →</mj-button>
    <mj-spacer height="36px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">Young Scandinavians Club</mj-text>
    <mj-spacer height="12px"></mj-spacer>
  </mj-column>
</mj-section>
