<mj-section background-color="#fff" border-radius="6px 6px 0px 0px" padding="48px 48px 24px 48px">
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text color="#000000" font-size="32px" line-height="1.25" padding="0px">
      <strong>Newsletter Stats Snapshot</strong>
    </mj-text>
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="16px" line-height="1.5" color="#64748b" padding="0px">
      Generated 24 hours after this newsletter was sent.
    </mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#fff" padding="0px 48px 24px 48px">
  <mj-column padding="0">
    <mj-text align="left" font-size="16px" line-height="1.6" padding="16px" color="#334155" container-background-color="#eff6ff">
      <strong>Newsletter:</strong> <%= @edition_title %><br />
      <strong>Subject:</strong> <%= @edition_subject %><br />
      <strong>Sent at:</strong> <%= @sent_at %>
    </mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#fff" padding="0px 48px 12px 48px">
  <mj-column padding="0">
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold" color="#0f172a">
      Engagement Metrics
    </mj-text>
  </mj-column>
</mj-section>

<%= for metric <- @metrics do %>
<mj-section background-color="#fff" padding="0px 48px 12px 48px">
  <mj-column padding="0">
    <mj-text align="left" font-size="14px" line-height="1.4" padding="16px" color="#64748b" container-background-color="<%= metric[:background] %>">
      <span style="text-transform: uppercase; letter-spacing: 0.05em;"><%= metric[:label] %></span><br />
      <span style="font-size: 32px; line-height: 1.3; font-weight: 700; color: <%= metric[:color] %>;"><%= metric[:value] %></span>
      <%= if metric[:helper] do %>
      <br /><span style="font-size: 14px; color: #64748b;"><%= metric[:helper] %></span>
      <% end %>
    </mj-text>
  </mj-column>
</mj-section>
<% end %>

<%= if @has_complaints do %>
<mj-section background-color="#fff" padding="0px 48px 24px 48px">
  <mj-column padding="0">
    <mj-text align="left" font-size="14px" line-height="1.4" padding="16px" color="#991b1b" container-background-color="#fef2f2">
      <span style="text-transform: uppercase; letter-spacing: 0.05em;">Complaints</span><br />
      <span style="font-size: 32px; line-height: 1.3; font-weight: 700; color: #991b1b;"><%= @complaints %></span>
    </mj-text>
  </mj-column>
</mj-section>
<% end %>

<%= if @has_top_links do %>
<mj-section background-color="#fff" padding="12px 48px 12px 48px">
  <mj-column padding="0">
    <mj-text align="left" font-size="24px" line-height="1.4" padding="0px" font-weight="bold" color="#0f172a">
      Top Clicked Links
    </mj-text>
  </mj-column>
</mj-section>

<%= for link <- @top_links do %>
<mj-section background-color="#fff" padding="0px 48px 12px 48px">
  <mj-column padding="0">
    <mj-text align="left" font-size="15px" line-height="1.5" padding="14px 16px" color="#334155" container-background-color="#f8fafc">
      <strong style="color: #1447e6;"><%= link[:clicks] %> clicks</strong>
      <%= if link[:title] do %>
      <br /><span style="font-size: 16px; color: #0f172a;"><%= link[:title] %></span>
      <% end %>
      <br /><a href="<%= link[:url] %>" style="color: #64748b; text-decoration: underline; word-break: break-all;"><%= link[:url] %></a>
    </mj-text>
  </mj-column>
</mj-section>
<% end %>
<% end %>

<mj-section background-color="#fff" border-radius="0px 0px 6px 6px" padding="12px 48px 48px 48px">
  <mj-column padding="0">
    <mj-divider border-width="1px" border-color="#e2e8f0" padding="0px 0px 20px 0px"></mj-divider>
    <mj-text align="left" font-size="14px" line-height="1.5" padding="0px" color="#64748b">
      Opens and clicks are unique recipient counts. Bounces and complaints are total delivery events.
    </mj-text>
  </mj-column>
</mj-section>
