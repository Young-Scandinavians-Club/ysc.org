<mj-section
  background-color="#fff"
  border-radius="6px 6px 0px 0px"
  padding-bottom="24px"
  padding-left="48px"
  padding-right="48px"
  padding-top="48px"
  padding="48px"
>
  <mj-column padding="0">
    <mj-spacer height="24px"></mj-spacer>
    <mj-text font-size="32px" line-height="1.25" padding="0px">
      <strong><%= if @reply, do: "New Reply on News Article", else: "New Comment on News Article" %></strong>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section
  background-color="#fff"
  border-radius="0px 0px 6px 6px"
  padding-bottom="48px"
  padding-left="48px"
  padding-right="48px"
  padding-top="20px"
  padding="48px"
>
  <mj-column padding="0">
    <mj-spacer height="12px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      Dear YSC Board Members,
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="0px">
      <%= @author_name %> posted a comment on the news article <strong><%= @post_title %></strong>.
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.5" padding="16px" background-color="#f8f9fa" border-radius="4px">
      <strong>Author:</strong> <%= @author_name %> (<a href="mailto:<%= @author_email %>" style="color: #1976d2;"><%= @author_email %></a>)<br/>
      <strong>Article:</strong> <%= @post_title %><br/>
      <strong>Posted:</strong> <%= @submitted_at %>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="left" font-size="20px" line-height="1.5" padding="0px" color="#1976d2">
      <strong>Comment:</strong>
    </mj-text>
    <mj-spacer height="16px"></mj-spacer>
    <mj-text align="left" font-size="18px" line-height="1.8" padding="20px" background-color="#e3f2fd" border-radius="6px" border="2px solid #1976d2" color="#424242" white-space="pre-wrap">
      <%= @comment_text %>
    </mj-text>
    <mj-spacer height="24px"></mj-spacer>
    <mj-button href="<%= @comment_url %>" css-class="btn_block" inner-padding="15px" width="100%" background-color="#1447e6" color="#ffffff" align="center" font-size="18px" border-radius="4px">View comment</mj-button>
    <mj-spacer height="24px"></mj-spacer>
    <mj-text align="center" font-size="12px" line-height="1.5" padding="0px" color="#666">
      This is an automated notification. Please do not reply to this email.
    </mj-text>
    <mj-spacer height="12px"></mj-spacer>
  </mj-column>
</mj-section>
