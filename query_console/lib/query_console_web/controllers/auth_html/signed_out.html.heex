<div class="min-h-screen flex items-center justify-center bg-base-200 px-4">
  <div class="max-w-md w-full text-center space-y-4 bg-base-100 border border-base-300 rounded-lg p-8 shadow-sm">
    <h1 class="text-2xl font-semibold">Signed out</h1>
    <p class="text-sm opacity-70">
      You have been signed out of the query console and YSC.
